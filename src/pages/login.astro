---
import { SignIn } from '@clerk/astro/components';
import BaseLayout from '../layouts/BaseLayout.astro';

// Clerk's hosted "Account Portal" sign-in page lives on Clerk's own domain
// (derived from the publishable key's Frontend API host), separate from any
// JS widget embedded on this site. Opening it directly sidesteps Safari ITP /
// cookie quirks that can break the in-page <SignIn/> widget.
// Algorithm mirrors @clerk/shared's parsePublishableKey + buildAccountsBaseUrl.
function getAccountsPortalSignInUrl(redirectUrl: string): string | null {
  const key = import.meta.env.PUBLIC_CLERK_PUBLISHABLE_KEY ?? '';
  if (!/^pk_(test|live)_/.test(key)) return null;

  const encoded = key.split('_')[2];
  if (!encoded) return null;

  let decoded: string;
  try {
    decoded = atob(encoded);
  } catch {
    return null;
  }
  if (!decoded.endsWith('$')) return null;

  const frontendApi = decoded.slice(0, -1);
  const accountsHost = frontendApi
    .replace(/clerk\.accountsstage\./, 'accountsstage.')
    .replace(/clerk\.accounts\.|clerk\./, 'accounts.');

  return `https://${accountsHost}/sign-in?redirect_url=${encodeURIComponent(redirectUrl)}`;
}

const redirectParam = Astro.url.searchParams.get('redirect');
const isSafeRedirect = !!redirectParam && redirectParam.startsWith('/') && !redirectParam.startsWith('//');
const redirectTarget = isSafeRedirect ? redirectParam : '/diary/';

const { userId } = Astro.locals.auth();
if (userId) {
  return Astro.redirect(redirectTarget);
}

const hostedSignInUrl =
  getAccountsPortalSignInUrl(`${Astro.url.origin}${redirectTarget}`) ??
  `/login?redirect=${encodeURIComponent(redirectTarget)}`;
---

<BaseLayout title="Login" description="ログイン">
  <div class="login-page">
    <div class="login-message">
      <h1>ログインが必要です</h1>
      <p>この記事はログインユーザー限定で公開しています。</p>
      <p>初めての方は、メールアドレスを登録してアカウントを作成してください。登録済みの方は、メールアドレスでログインしてください。</p>
    </div>
    <SignIn forceRedirectUrl={redirectTarget} />

    <p class="login-fallback">
      ログイン画面が表示されない場合は、
      <a href={hostedSignInUrl} target="_blank" rel="noopener noreferrer">別ウィンドウでログインページを開く</a>
      をお試しください。Safariでは、Cookieやキャッシュの影響で表示されないことがあります。
    </p>
  </div>
</BaseLayout>

<style>
  .login-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
    padding-block: 56px;
  }

  .login-message {
    max-width: 420px;
    text-align: center;
  }

  .login-message h1 {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 12px;
  }

  .login-message p {
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-muted);
  }

  .login-message p + p {
    margin-top: 8px;
  }

  .login-fallback {
    max-width: 420px;
    text-align: center;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .login-fallback a {
    color: var(--color-text);
    text-decoration: underline;
  }
</style>
