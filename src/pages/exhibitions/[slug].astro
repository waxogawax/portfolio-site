---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TermGraphPanel from '../../components/TermGraphPanel.astro';
import { buildTermGraph } from '../../lib/termGraph.ts';

export const prerender = true;

export async function getStaticPaths() {
  const [entries, graph, works, writings] = await Promise.all([
    getCollection('exhibitions', ({ data }) => data.draft !== true),
    buildTermGraph(),
    getCollection('works'),
    getCollection('writings'),
  ]);

  const workTitles = new Map(works.map((w) => [w.id.replace(/\.md$/, ''), w.data.title]));
  const writingTitles = new Map(writings.map((w) => [w.id.replace(/\.md$/, ''), w.data.title]));

  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry, graph, workTitles, writingTitles },
  }));
}

const { entry, graph, workTitles, writingTitles } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const pageId = `exhibitions/${entry.id.replace(/\.md$/, '')}`;
const pageData = graph.pages[pageId];

function formatDate(date: Date): string {
  return date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' });
}

function formatDateRange(start: Date, end?: Date): string {
  if (!end) return formatDate(start);
  return `${formatDate(start)} – ${formatDate(end)}`;
}
---

<BaseLayout title={d.title} description={d.description}>

  <!-- 1. Back + Title + Meta -->
  <div class="exh-header">
    <a href="/exhibitions/" class="article-back">← Exhibitions</a>

    <h1 class="exh-title">{d.title}</h1>

    <div class="exh-meta-grid">
      <div class="exh-meta-item">
        <span class="exh-meta-label">Year</span>
        <span class="exh-meta-value">{d.year}</span>
      </div>
      <div class="exh-meta-item">
        <span class="exh-meta-label">Date</span>
        <span class="exh-meta-value">{formatDateRange(d.startDate, d.endDate)}</span>
      </div>
      <div class="exh-meta-item">
        <span class="exh-meta-label">Venue</span>
        <span class="exh-meta-value">{d.venue}</span>
      </div>
      <div class="exh-meta-item">
        <span class="exh-meta-label">City</span>
        <span class="exh-meta-value">
          {d.city}{d.country !== 'Japan' ? `, ${d.country}` : ''}
        </span>
      </div>
      <div class="exh-meta-item">
        <span class="exh-meta-label">Type</span>
        <span class="exh-meta-value">{d.type}</span>
      </div>
      <div class="exh-meta-item">
        <span class="exh-meta-label">Role</span>
        <span class="exh-meta-value">{d.role}</span>
      </div>
      {d.artists.length > 0 && (
        <div class="exh-meta-item" style="grid-column: 1 / -1;">
          <span class="exh-meta-label">Artists</span>
          <span class="exh-meta-value">{d.artists.join(', ')}</span>
        </div>
      )}
    </div>
  </div>

  <!-- 3. Cover image -->
  {d.cover && (
    <div class="exh-cover exh-img-wrap">
      <img src={d.cover} alt={`${d.title} — cover`} class="exh-img" />
    </div>
  )}

  <!-- 4. Description + 5. Concept body -->
  <div class="exh-narrow">

    {d.description && (
      <div class="exh-section">
        <p class="exh-description">{d.description}</p>
      </div>
    )}

    <div class="exh-section">
      <p class="exh-section-label">Concept</p>
      <div class="exh-concept">
        <Content />
      </div>
    </div>

  </div>

  <!-- 6. Image gallery (wider) -->
  {d.images.length > 0 && (
    <div class="exh-gallery-section">
      <p class="exh-section-label">Images</p>
      <div class="exh-gallery-grid">
        {d.images.map((img) => (
          <figure class="exh-gallery-item exh-img-wrap">
            <img src={img.src} alt={img.alt ?? img.caption ?? d.title} loading="lazy" class="exh-img" />
            {(img.caption || img.credit) && (
              <figcaption class="exh-gallery-caption">
                {img.caption}
                {img.caption && img.credit && ' '}
                {img.credit && <span class="exh-gallery-credit">© {img.credit}</span>}
              </figcaption>
            )}
          </figure>
        ))}
      </div>
    </div>
  )}

  <!-- 6b. Video gallery (wider) -->
  {d.videos.length > 0 && (
    <div class="exh-gallery-section">
      <p class="exh-section-label">Videos</p>
      <div class="exh-gallery-grid">
        {d.videos.map((vid) => (
          <figure class="exh-gallery-item">
            <video src={vid.src} controls preload="metadata" class="exh-video" />
            {vid.caption && (
              <figcaption class="exh-gallery-caption">{vid.caption}</figcaption>
            )}
          </figure>
        ))}
      </div>
    </div>
  )}

  <!-- 7. Links / 8. Press / 9. Instagram / 10. Related -->
  <div class="exh-narrow">

    {d.links.length > 0 && (
      <div class="exh-section">
        <p class="exh-section-label">Links</p>
        <ul class="exh-links-list">
          {d.links.map((link) => (
            <li class="exh-link-item">
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {d.press.length > 0 && (
      <div class="exh-section">
        <p class="exh-section-label">Press</p>
        <ul class="exh-press-list">
          {d.press.map((item) => (
            <li class="exh-press-item">
              {item.url ? (
                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="exh-press-title"
                >
                  {item.title}
                </a>
              ) : (
                <span class="exh-press-title">{item.title}</span>
              )}
              <span class="exh-press-meta">
                {item.publication}
                {item.date && ` / ${item.date.toLocaleDateString('ja-JP', { year: 'numeric', month: 'long', day: 'numeric' })}`}
              </span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {d.social?.instagram && (
      <div class="exh-section">
        <p class="exh-section-label">Instagram</p>
        <a
          href={d.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="exh-instagram-link"
        >
          展示の記録を見る
        </a>
      </div>
    )}

    {(d.relatedWorks.length > 0 || d.relatedWritings.length > 0) && (
      <div class="exh-section">
        <p class="exh-section-label">Related</p>
        {d.relatedWorks.length > 0 && (
          <>
            <p style="font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted); margin-bottom: 8px;">Works</p>
            <ul class="exh-related-list" style="margin-bottom: 20px;">
              {d.relatedWorks.map((slug) => (
                <li class="exh-related-item">
                  <a href={`/works/${slug}/`}>{workTitles.get(slug) ?? slug}</a>
                </li>
              ))}
            </ul>
          </>
        )}
        {d.relatedWritings.length > 0 && (
          <>
            <p style="font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--color-muted); margin-bottom: 8px;">本展に寄せた文章</p>
            <ul class="exh-related-list">
              {d.relatedWritings.map((slug) => (
                <li class="exh-related-item">
                  <a href={`/writings/${slug}/`}>{writingTitles.get(slug) ?? slug}</a>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    )}

  </div>

  <!-- Term graph panel (below main content to preserve full-width gallery layout) -->
  {pageData && (
    <div class="exh-narrow" style="margin-top: 0; padding-top: 0;">
      <TermGraphPanel pageData={pageData} graph={graph} />
    </div>
  )}

  <!-- Lightbox overlay -->
  <div class="exh-lightbox" id="exh-lightbox" aria-hidden="true" role="dialog" aria-modal="true" aria-label="画像の拡大表示">
    <img class="exh-lightbox-img" src="" alt="" />
  </div>

</BaseLayout>

<style>
  /* Image loading shimmer */
  .exh-img-wrap {
    position: relative;
    background-color: var(--color-hover-bg, #f0f0f0);
    overflow: hidden;
  }

  .exh-img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgba(255, 255, 255, 0.35) 50%,
      transparent 100%
    );
    background-size: 200% 100%;
    animation: exh-shimmer 1.4s ease-in-out infinite;
    pointer-events: none;
    transition: opacity 0.3s ease;
  }

  .exh-img-wrap.is-loaded::after {
    opacity: 0;
    animation: none;
  }

  @keyframes exh-shimmer {
    0%   { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  .exh-img {
    opacity: 0;
    transition: opacity 0.4s ease;
    display: block;
    width: 100%;
  }

  .exh-img-wrap.is-loaded .exh-img {
    opacity: 1;
  }

  .exh-gallery-item img {
    cursor: zoom-in;
  }

  .exh-gallery-credit {
    opacity: 0.75;
  }

  .exh-video {
    display: block;
    width: 100%;
  }

  .exh-lightbox {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(0, 0, 0, 0.92);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: zoom-out;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }

  .exh-lightbox.is-open {
    opacity: 1;
    pointer-events: all;
  }

  .exh-lightbox-img {
    max-width: 92vw;
    max-height: 92vh;
    object-fit: contain;
    display: block;
  }
</style>

<script>
  const lightbox = document.getElementById('exh-lightbox') as HTMLElement;
  const lightboxImg = lightbox.querySelector('.exh-lightbox-img') as HTMLImageElement;

  function openLightbox(src: string, alt: string) {
    lightboxImg.src = src;
    lightboxImg.alt = alt;
    lightbox.classList.add('is-open');
    lightbox.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    lightbox.classList.remove('is-open');
    lightbox.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLImageElement>('.exh-gallery-item img').forEach(img => {
    img.addEventListener('click', () => openLightbox(img.src, img.alt));
  });

  lightbox.addEventListener('click', closeLightbox);

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeLightbox();
  });

  // Image loading shimmer
  document.querySelectorAll<HTMLImageElement>('.exh-img-wrap .exh-img').forEach(img => {
    const wrap = img.closest<HTMLElement>('.exh-img-wrap');
    if (!wrap) return;
    if (img.complete && img.naturalWidth > 0) {
      wrap.classList.add('is-loaded');
    } else {
      img.addEventListener('load', () => wrap.classList.add('is-loaded'));
      img.addEventListener('error', () => wrap.classList.add('is-loaded'));
    }
  });
</script>
