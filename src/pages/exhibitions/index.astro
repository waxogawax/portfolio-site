---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

const entries = await getCollection('exhibitions', ({ data }) => {
  return data.draft !== true;
});

const sortedEntries = entries.sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf()
);

function formatDateRange(start: Date, end?: Date): string {
  const opts: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
  const s = start.toLocaleDateString('ja-JP', opts);
  if (!end) return s;
  if (start.getFullYear() === end.getFullYear() && start.getMonth() === end.getMonth()) {
    return `${start.toLocaleDateString('ja-JP', { month: 'long', day: 'numeric' })} – ${end.toLocaleDateString('ja-JP', { day: 'numeric' })}, ${start.getFullYear()}`;
  }
  return `${s} – ${end.toLocaleDateString('ja-JP', opts)}`;
}

// A row's hover layer is a small cluster of images, not one documentation
// shot: a mandatory "main" image (cover, falling back to a hand-picked
// fragment, falling back to the first gallery photo) plus up to 3 more
// gallery photos that scatter in at random positions/sizes client-side.
function scatterFor(data: (typeof sortedEntries)[number]['data']) {
  const mainSrc = data.cover ?? data.previewImage?.src ?? data.images[0]?.src;
  if (!mainSrc) return null;
  const mainAlt = data.previewImage?.alt ?? data.title;
  const extras = data.images
    .filter((img) => img.src !== mainSrc)
    .slice(0, 3)
    .map((img) => ({ src: img.src, alt: img.alt ?? img.caption ?? data.title }));
  return {
    main: { src: mainSrc, alt: mainAlt, mobileCropPosition: data.previewImage?.mobileCropPosition },
    extras,
  };
}
---

<BaseLayout title="Exhibitions" description="展示記録の一覧">
  <div class="page-heading">
    <h1>Exhibitions</h1>
    <p>{sortedEntries.length} exhibitions</p>
  </div>

  <ul class="exh-list" id="exh-list">
    {sortedEntries.map((entry) => {
      const scatter = scatterFor(entry.data);
      return (
        <li>
          <a
            href={`/exhibitions/${entry.id.replace(/\.md$/, '')}/`}
            class="exh-item"
            data-preview-src={scatter?.main.src}
            data-preview-alt={scatter?.main.alt ?? entry.data.title}
            data-preview-extra={scatter ? JSON.stringify(scatter.extras) : undefined}
          >
            <span class="exh-item-year">{entry.data.year}</span>
            <div class="exh-item-body">
              <span class="exh-item-type">{entry.data.type}</span>
              <span class="exh-item-title">{entry.data.title}</span>
              {scatter && (
                <img
                  class="exh-item-fragment"
                  src={scatter.main.src}
                  alt={scatter.main.alt}
                  loading="lazy"
                  style={scatter.main.mobileCropPosition ? `object-position:${scatter.main.mobileCropPosition}` : undefined}
                />
              )}
              <span class="exh-item-venue">
                {entry.data.venue}, {entry.data.city}
                {entry.data.country !== 'Japan' && `, ${entry.data.country}`}
                <span style="margin-left: 8px; color: var(--color-border);">|</span>
                <span style="margin-left: 8px;">{formatDateRange(entry.data.startDate, entry.data.endDate)}</span>
              </span>
              {entry.data.tags.length > 0 && (
                <div class="exh-item-tags">
                  {entry.data.tags.map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </a>
        </li>
      );
    })}
  </ul>

  <div class="exh-scatter" id="exh-scatter" aria-hidden="true"></div>
</BaseLayout>

<style>
  /* ── Row hover / focus dimming (desktop only; harmless no-op elsewhere) ── */
  .exh-item {
    transition: opacity var(--transition);
  }

  .exh-list.has-active .exh-item:not(.is-active) {
    opacity: 0.72;
  }

  /* ── Mobile image fragment: hidden on desktop, a thin strip on mobile ── */
  .exh-item-fragment {
    display: none;
  }

  /* ── Floating desktop image scatter ──
     Fixed, non-interactive layer. JS populates it with a handful of <img>
     tiles positioned entirely within the side gutters outside the text
     column (measured live against #exh-list's bounding box), so it can
     never sit on top of a clickable row. Sizes/positions/rotation are
     randomized per reveal for the "ぱらぱら" scattered feel. */
  .exh-scatter {
    position: fixed;
    inset: 0;
    z-index: 8; /* above content, below site-header (10) and any modal overlay */
    pointer-events: none;
  }

  .exh-scatter-item {
    position: fixed;
    display: block;
    object-fit: cover;
    background: var(--color-bg);
    border: 1px solid var(--preview-border);
    box-shadow: 0 8px 28px var(--preview-shadow);
    opacity: 0;
    transform: rotate(var(--rot, 0deg)) scale(0.92);
    transition: opacity 220ms ease, transform 220ms ease;
  }

  .exh-scatter-item.is-visible {
    opacity: 1;
    transform: rotate(var(--rot, 0deg)) scale(1);
  }

  @media (max-width: 768px) {
    .exh-scatter {
      display: none;
    }

    .exh-item-fragment {
      display: block;
      width: 100%;
      height: clamp(96px, 26vw, 140px);
      object-fit: cover;
      margin: 6px 0 2px;
      border: 1px solid var(--preview-border);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exh-item {
      transition: none;
    }
    .exh-scatter-item {
      transition: opacity 150ms ease;
      transform: none !important;
    }
  }
</style>

<script>
  const list = document.getElementById('exh-list');
  const scatterLayer = document.getElementById('exh-scatter');
  const rows = document.querySelectorAll<HTMLAnchorElement>('.exh-item[data-preview-src]');

  if (list && scatterLayer && rows.length > 0) {
    let activeRow: HTMLAnchorElement | null = null;

    const MIN_GUTTER = 96; // px — below this, that side has no safe space at all

    function rand(min: number, max: number) {
      return Math.random() * (max - min) + min;
    }

    // The only zone tiles are allowed in: outside #exh-list's own box, so
    // they can never overlap a row — measured live so it adapts to viewport
    // width, zoom, etc.
    function getGutters() {
      const rect = list!.getBoundingClientRect();
      return {
        left: Math.max(0, rect.left),
        right: Math.max(0, window.innerWidth - rect.right),
      };
    }

    function clearScatter() {
      scatterLayer!.innerHTML = '';
    }

    function placeTile(
      src: string,
      alt: string,
      opts: { minW: number; maxW: number; ratioMin: number; ratioMax: number },
      isMain: boolean,
      index: number
    ) {
      const gutters = getGutters();
      const sides: Array<'left' | 'right'> = [];
      if (gutters.left >= MIN_GUTTER) sides.push('left');
      if (gutters.right >= MIN_GUTTER) sides.push('right');
      if (sides.length === 0) return; // no safe space anywhere — skip silently

      const side: 'left' | 'right' = isMain
        ? gutters.left >= gutters.right
          ? (sides.includes('left') ? 'left' : 'right')
          : (sides.includes('right') ? 'right' : 'left')
        : sides[Math.floor(Math.random() * sides.length)];

      const gutterWidth = side === 'left' ? gutters.left : gutters.right;
      const maxW = Math.min(opts.maxW, gutterWidth - 16);
      if (maxW < 64) return; // too tight even for a small tile — skip

      const w = Math.round(rand(Math.min(opts.minW, maxW), maxW));
      const h = Math.round(w * rand(opts.ratioMin, opts.ratioMax));
      const top = Math.round(rand(120, Math.max(160, window.innerHeight - h - 100)));
      const insetFromEdge = Math.round(rand(12, Math.max(12, gutterWidth - w - 8)));
      const rot = rand(-7, 7).toFixed(1);

      const img = document.createElement('img');
      img.src = src;
      img.alt = alt;
      img.loading = 'lazy';
      img.className = 'exh-scatter-item';
      img.style.width = w + 'px';
      img.style.height = h + 'px';
      img.style.top = top + 'px';
      img.style.setProperty('--rot', rot + 'deg');
      img.style.transitionDelay = index * 70 + 'ms';
      if (side === 'left') {
        img.style.left = insetFromEdge + 'px';
      } else {
        img.style.right = insetFromEdge + 'px';
      }
      scatterLayer!.appendChild(img);
      requestAnimationFrame(() => requestAnimationFrame(() => img.classList.add('is-visible')));
    }

    function showScatterFor(row: HTMLAnchorElement) {
      clearScatter();
      const src = row.dataset.previewSrc;
      if (!src) return;
      const alt = row.dataset.previewAlt ?? '';
      let extras: Array<{ src: string; alt?: string }> = [];
      try {
        extras = JSON.parse(row.dataset.previewExtra ?? '[]');
      } catch {
        extras = [];
      }

      // The main image is a must — the larger, more prominent tile.
      placeTile(src, alt, { minW: 170, maxW: 260, ratioMin: 0.68, ratioMax: 1.0 }, true, 0);
      // 2–3 extras — smaller and more varied in shape.
      extras.slice(0, 3).forEach((ex, i) => {
        placeTile(ex.src, ex.alt ?? alt, { minW: 90, maxW: 170, ratioMin: 0.7, ratioMax: 1.35 }, false, i + 1);
      });
    }

    function hideScatter() {
      scatterLayer!.querySelectorAll('.exh-scatter-item').forEach((el) => el.classList.remove('is-visible'));
      window.setTimeout(clearScatter, 260);
    }

    function activate(row: HTMLAnchorElement) {
      row.classList.add('is-active');
      list?.classList.add('has-active');
      activeRow = row;
      showScatterFor(row);
    }

    function deactivate(row: HTMLAnchorElement) {
      row.classList.remove('is-active');
      if (activeRow !== row) return;
      activeRow = null;
      list?.classList.remove('has-active');
      hideScatter();
    }

    rows.forEach((row) => {
      row.addEventListener('mouseenter', () => activate(row));
      row.addEventListener('mouseleave', () => deactivate(row));
      row.addEventListener('focus', () => activate(row));
      row.addEventListener('blur', () => deactivate(row));
    });

    // Preload each row's main image as it nears the viewport, so the
    // hover/idle reveal itself never waits on a network fetch.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (ioEntries) => {
          ioEntries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const src = (entry.target as HTMLAnchorElement).dataset.previewSrc;
            if (src) {
              const img = new Image();
              img.src = src;
            }
            io.unobserve(entry.target);
          });
        },
        { rootMargin: '200px 0px' }
      );
      rows.forEach((row) => io.observe(row));
    }

    // Idle: before any interaction, show one random exhibition's cluster so
    // the page doesn't feel empty on arrival. Purely ambient — it doesn't
    // dim rows or count as "active"; the first real hover/focus replaces it.
    if (window.matchMedia('(min-width: 769px)').matches) {
      window.setTimeout(() => {
        if (activeRow) return;
        const idle = rows[Math.floor(Math.random() * rows.length)];
        showScatterFor(idle);
      }, 700);
    }
  }
</script>
