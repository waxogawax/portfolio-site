---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const prerender = true;

const entries = await getCollection('exhibitions', ({ data }) => {
  return data.draft !== true;
});

const sortedEntries = entries.sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf()
);

function formatDateRange(start: Date, end?: Date): string {
  const opts: Intl.DateTimeFormatOptions = { year: 'numeric', month: 'long', day: 'numeric' };
  const s = start.toLocaleDateString('ja-JP', opts);
  if (!end) return s;
  if (start.getFullYear() === end.getFullYear() && start.getMonth() === end.getMonth()) {
    return `${start.toLocaleDateString('ja-JP', { month: 'long', day: 'numeric' })} – ${end.toLocaleDateString('ja-JP', { day: 'numeric' })}, ${start.getFullYear()}`;
  }
  return `${s} – ${end.toLocaleDateString('ja-JP', opts)}`;
}

// previewImage is explicitly hand-picked for this index experience, so it
// takes priority over the documentation cover — a fragment, not a poster.
function previewFor(data: (typeof sortedEntries)[number]['data']) {
  const mainSrc = data.previewImage?.src ?? data.images[0]?.src ?? data.cover;
  if (!mainSrc) return null;
  const mainAlt = data.previewImage?.alt ?? data.title;
  const extras = data.images
    .filter((img) => img.src !== mainSrc)
    .slice(0, 2)
    .map((img) => ({ src: img.src, alt: img.alt ?? img.caption ?? data.title }));
  return {
    main: { src: mainSrc, alt: mainAlt, mobileCropPosition: data.previewImage?.mobileCropPosition },
    extras,
  };
}
---

<BaseLayout title="Exhibitions" description="展示記録の一覧">
  <div class="exhibitions-page" id="exhibitions-page">
    <div class="exhibitions-content" id="exhibitions-content">
      <div class="page-heading">
        <h1>Exhibitions</h1>
        <p>{sortedEntries.length} exhibitions</p>
      </div>

      <ul class="exh-list" id="exh-list">
        {sortedEntries.map((entry) => {
          const preview = previewFor(entry.data);
          return (
            <li>
              <a
                href={`/exhibitions/${entry.id.replace(/\.md$/, '')}/`}
                class="exh-item"
                data-exh-id={entry.id}
                data-preview-src={preview?.main.src}
                data-preview-alt={preview?.main.alt ?? entry.data.title}
                data-preview-extra={preview ? JSON.stringify(preview.extras) : undefined}
              >
                <span class="exh-item-year">{entry.data.year}</span>
                <div class="exh-item-body">
                  <span class="exh-item-type">{entry.data.type}</span>
                  <span class="exh-item-title">{entry.data.title}</span>
                  {preview && (
                    <img
                      class="exh-item-fragment"
                      src={preview.main.src}
                      alt={preview.main.alt}
                      loading="lazy"
                      style={preview.main.mobileCropPosition ? `object-position:${preview.main.mobileCropPosition}` : undefined}
                    />
                  )}
                  <span class="exh-item-venue">
                    {entry.data.venue}, {entry.data.city}
                    {entry.data.country !== 'Japan' && `, ${entry.data.country}`}
                    <span style="margin-left: 8px; color: var(--color-border);">|</span>
                    <span style="margin-left: 8px;">{formatDateRange(entry.data.startDate, entry.data.endDate)}</span>
                  </span>
                  {entry.data.tags.length > 0 && (
                    <div class="exh-item-tags">
                      {entry.data.tags.map((tag) => (
                        <span class="tag">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <!-- Dedicated right-side compositional field. A fixed pool of 3 tiles is
         reused across hovers; CSS positions them per data-layout so every
         reveal is one of a few deliberate compositions, never random. -->
    <div class="exh-preview-field" id="exh-preview-field" data-layout="solo" aria-hidden="true">
      <img class="exh-preview-tile exh-tile-main" id="exh-tile-main" alt="" />
      <img class="exh-preview-tile exh-tile-extra-0" id="exh-tile-extra-0" alt="" />
      <img class="exh-preview-tile exh-tile-extra-1" id="exh-tile-extra-1" alt="" />
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Row hover / focus dimming (desktop only; harmless no-op elsewhere) ── */
  .exh-item {
    transition: opacity var(--transition);
  }

  .exh-list.has-active .exh-item:not(.is-active) {
    opacity: 0.72;
  }

  /* ── Mobile image fragment: hidden on desktop, a thin strip on mobile ── */
  .exh-item-fragment {
    display: none;
  }

  /* ── Split-layout hover: text column compresses left to make room ──
     Default state is untouched (width:100%, no transform) — this only
     engages once .exhibitions-page carries .has-preview, and only on
     desktop widths (see media query below). */
  .exhibitions-content {
    width: 100%;
    transform: translateX(0);
    transition: width 280ms cubic-bezier(0.22, 1, 0.36, 1), transform 280ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ── Right-side preview field: a fixed compositional frame, not a floating
     thumbnail layer. Images are positioned inside it per data-layout. ── */
  .exh-preview-field {
    position: fixed;
    top: 73px; /* below the sticky site-header */
    right: 0;
    width: 48vw;
    height: calc(100vh - 73px);
    pointer-events: none;
    overflow: hidden;
    z-index: 8; /* above content, below site-header (10) and any modal overlay */
    display: none;
  }

  .exh-preview-tile {
    position: absolute;
    display: block;
    object-fit: contain;
    background: var(--color-bg);
    border: 1px solid var(--preview-border);
    box-shadow: 0 8px 28px var(--preview-shadow);
    opacity: 0;
    transform: translateX(16px);
    transition: opacity 220ms ease, transform 220ms ease;
  }

  .exh-preview-tile.is-visible {
    opacity: 1;
    transform: translateX(0);
  }

  /* Layout: a single image (no gallery extras available) */
  .exh-preview-field[data-layout='solo'] .exh-tile-main {
    left: 5%;
    top: 5%;
    width: 90%;
    height: 90%;
  }
  .exh-preview-field[data-layout='solo'] .exh-tile-extra-0,
  .exh-preview-field[data-layout='solo'] .exh-tile-extra-1 {
    display: none;
  }

  /* Layout: main + one supporting fragment, side by side */
  .exh-preview-field[data-layout='pair'] .exh-tile-main {
    left: 3%;
    top: 5%;
    width: 58%;
    height: 90%;
  }
  .exh-preview-field[data-layout='pair'] .exh-tile-extra-0 {
    right: 3%;
    top: 5%;
    width: 34%;
    height: 90%;
  }
  .exh-preview-field[data-layout='pair'] .exh-tile-extra-1 {
    display: none;
  }

  /* Layout A: main left, two stacked right */
  .exh-preview-field[data-layout='a'] .exh-tile-main {
    left: 4%;
    top: 6%;
    width: 56%;
    height: 88%;
  }
  .exh-preview-field[data-layout='a'] .exh-tile-extra-0 {
    right: 4%;
    top: 6%;
    width: 38%;
    height: 41%;
  }
  .exh-preview-field[data-layout='a'] .exh-tile-extra-1 {
    right: 4%;
    bottom: 6%;
    width: 38%;
    height: 41%;
  }

  /* Layout B: main on top, two smaller below */
  .exh-preview-field[data-layout='b'] .exh-tile-main {
    left: 5%;
    top: 5%;
    width: 90%;
    height: 56%;
  }
  .exh-preview-field[data-layout='b'] .exh-tile-extra-0 {
    left: 5%;
    bottom: 5%;
    width: 43%;
    height: 35%;
  }
  .exh-preview-field[data-layout='b'] .exh-tile-extra-1 {
    right: 5%;
    bottom: 5%;
    width: 43%;
    height: 35%;
  }

  /* Layout C: two overlapping verticals + one small detail */
  .exh-preview-field[data-layout='c'] .exh-tile-main {
    left: 4%;
    top: 6%;
    width: 50%;
    height: 88%;
  }
  .exh-preview-field[data-layout='c'] .exh-tile-extra-0 {
    left: 44%;
    top: 16%;
    width: 46%;
    height: 62%;
  }
  .exh-preview-field[data-layout='c'] .exh-tile-extra-1 {
    right: 4%;
    bottom: 4%;
    width: 28%;
    height: 26%;
  }

  @media (min-width: 769px) {
    .exh-preview-field {
      display: block;
    }

    .exhibitions-page.has-preview .exhibitions-content {
      width: 52vw;
      transform: translateX(-2vw);
    }
  }

  @media (max-width: 768px) {
    .exh-item-fragment {
      display: block;
      width: 100%;
      height: clamp(96px, 26vw, 140px);
      object-fit: cover;
      margin: 6px 0 2px;
      border: 1px solid var(--preview-border);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exh-item,
    .exhibitions-content {
      transition: none;
    }
    .exh-preview-tile {
      transition: opacity 150ms ease;
      transform: none !important;
    }
  }
</style>

<script>
  const page = document.getElementById('exhibitions-page');
  const list = document.getElementById('exh-list');
  const field = document.getElementById('exh-preview-field');
  const mainTile = document.getElementById('exh-tile-main') as HTMLImageElement | null;
  const extraTiles = [
    document.getElementById('exh-tile-extra-0') as HTMLImageElement | null,
    document.getElementById('exh-tile-extra-1') as HTMLImageElement | null,
  ];
  const rows = document.querySelectorAll<HTMLAnchorElement>('.exh-item[data-preview-src]');

  if (page && list && field && mainTile && rows.length > 0) {
    let activeRow: HTMLAnchorElement | null = null;

    // Stable per-exhibition hash so the same show always gets the same
    // 3-image composition, rather than reshuffling on every hover.
    function hashCode(str: string) {
      let h = 0;
      for (let i = 0; i < str.length; i++) h = (h * 31 + str.charCodeAt(i)) | 0;
      return Math.abs(h);
    }

    const THREE_IMAGE_LAYOUTS = ['a', 'b', 'c'];

    function pickLayout(id: string, extrasCount: number) {
      if (extrasCount === 0) return 'solo';
      if (extrasCount === 1) return 'pair';
      return THREE_IMAGE_LAYOUTS[hashCode(id) % THREE_IMAGE_LAYOUTS.length];
    }

    function reveal(tile: HTMLImageElement, src: string, alt: string, delayMs: number) {
      tile.classList.remove('is-visible');
      tile.style.display = '';
      tile.style.transitionDelay = delayMs + 'ms';
      if (tile.getAttribute('src') !== src) {
        tile.src = src;
        tile.alt = alt;
      }
      requestAnimationFrame(() => requestAnimationFrame(() => tile.classList.add('is-visible')));
    }

    function showPreviewFor(row: HTMLAnchorElement) {
      const src = row.dataset.previewSrc;
      if (!src || !mainTile || !field) return;
      const alt = row.dataset.previewAlt ?? '';
      let extras: Array<{ src: string; alt?: string }> = [];
      try {
        extras = JSON.parse(row.dataset.previewExtra ?? '[]');
      } catch {
        extras = [];
      }
      extras = extras.slice(0, 2);

      field.dataset.layout = pickLayout(row.dataset.exhId ?? src, extras.length);

      reveal(mainTile, src, alt, 0);
      extraTiles.forEach((tile, i) => {
        if (!tile) return;
        const ex = extras[i];
        if (ex) {
          reveal(tile, ex.src, ex.alt ?? alt, 50 + i * 50);
        } else {
          tile.classList.remove('is-visible');
        }
      });
    }

    function activate(row: HTMLAnchorElement) {
      row.classList.add('is-active');
      list?.classList.add('has-active');
      page?.classList.add('has-preview');
      activeRow = row;
      showPreviewFor(row);
    }

    function deactivate(row: HTMLAnchorElement) {
      row.classList.remove('is-active');
      if (activeRow !== row) return;
      activeRow = null;
      list?.classList.remove('has-active');
      page?.classList.remove('has-preview');
      mainTile?.classList.remove('is-visible');
      extraTiles.forEach((t) => t?.classList.remove('is-visible'));
    }

    rows.forEach((row) => {
      row.addEventListener('mouseenter', () => activate(row));
      row.addEventListener('mouseleave', () => deactivate(row));
      row.addEventListener('focus', () => activate(row));
      row.addEventListener('blur', () => deactivate(row));
    });

    // Preload each row's images as it nears the viewport, so a hover reveal
    // never waits on a network fetch.
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (ioEntries) => {
          ioEntries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLAnchorElement;
            const srcs = [el.dataset.previewSrc];
            try {
              JSON.parse(el.dataset.previewExtra ?? '[]').forEach((ex: { src: string }) => srcs.push(ex.src));
            } catch {
              // ignore
            }
            srcs.filter(Boolean).forEach((s) => {
              const img = new Image();
              img.src = s as string;
            });
            io.unobserve(entry.target);
          });
        },
        { rootMargin: '200px 0px' }
      );
      rows.forEach((row) => io.observe(row));
    }
  }
</script>
