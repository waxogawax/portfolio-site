---
import BaseLayout from '../layouts/BaseLayout.astro';

Astro.response.status = 404;
---

<BaseLayout title="Not Found" description="ページが見つかりません">
  <div class="not-found-page">
    <h1>404</h1>
    <p>ページが見つかりませんでした。</p>
    <a href="/">トップへ戻る</a>
  </div>
</BaseLayout>

<style>
  .not-found-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    padding-block: 96px;
    text-align: center;
  }

  .not-found-page h1 {
    font-family: var(--font-serif);
    font-size: 2.4rem;
    font-weight: 500;
  }
</style>
