---
import { SignOutButton } from '@clerk/astro/components';
import BaseLayout from '../layouts/BaseLayout.astro';

const { userId } = Astro.locals.auth();
if (!userId) {
  return Astro.redirect('/');
}
---

<BaseLayout title="Logout" description="ログアウト">
  <div class="logout-page">
    <p>ログアウトしますか？</p>
    <SignOutButton redirectUrl="/" asChild>
      <button class="logout-button" type="button">ログアウト</button>
    </SignOutButton>
  </div>
</BaseLayout>

<style>
  .logout-page {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    padding-block: 80px;
  }

  .logout-button {
    font-family: inherit;
    font-size: 0.9rem;
    padding: 8px 20px;
    border: 1px solid var(--color-border);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }

  .logout-button:hover {
    border-color: var(--color-text);
  }
</style>
