---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TermGraphPanel from '../../components/TermGraphPanel.astro';
import { buildTermGraph } from '../../lib/termGraph.ts';

const { slug } = Astro.params;
const entry = slug ? await getEntry('diary', slug) : undefined;

if (!entry || entry.data.draft || entry.data.visibility === 'private') {
  return Astro.rewrite('/404');
}

if (entry.data.visibility === 'members') {
  const { userId } = Astro.locals.auth();
  if (!userId) {
    return Astro.redirect(`/login?redirect=/diary/${slug}`);
  }
}

const graph = await buildTermGraph();
const { Content } = await render(entry);

const pageId = `diary/${entry.id.replace(/\.md$/, '')}`;
const pageData = graph.pages[pageId];
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="page-with-sidebar">

    <div class="page-main">
      <div class="article-meta">
        <a href="/diary/" class="article-back">← Diary</a>
        <h1 class="article-title">{entry.data.title}</h1>
        <time class="article-date" datetime={entry.data.date.toISOString()}>
          {entry.data.date.toLocaleDateString('ja-JP')}
        </time>
        {entry.data.description && (
          <p class="article-description">{entry.data.description}</p>
        )}
      </div>

      <div class="article-body">
        <Content />
      </div>
    </div>

    <TermGraphPanel pageData={pageData} graph={graph} />

  </div>
</BaseLayout>

<style>
  .page-with-sidebar {
    display: grid;
    grid-template-columns: 1fr 288px;
    gap: 0 48px;
    max-width: calc(var(--width-article) + 336px);
    margin-inline: auto;
    padding-inline: var(--pad-h);
    align-items: start;
  }

  .page-main {
    min-width: 0;
  }

  /* Inherit article-body styles from global CSS */
  .page-main :global(.article-body) {
    border-top: 1px solid var(--color-border);
    padding-top: 40px;
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.9;
  }

  @media (max-width: 960px) {
    .page-with-sidebar {
      grid-template-columns: 1fr;
    }
  }
</style>
