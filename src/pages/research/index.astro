---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  profile,
  researchInterests,
  currentResearch,
  publicationsPeerReviewed,
  publicationsBookChapters,
  publicationsMisc,
  presentations,
  grants,
  awards,
  teaching,
  experience,
  education,
  academicService,
  selectedPrograms,
} from '../../data/researchData.ts';

export const prerender = true;

const byYearDesc = <T extends { year: number }>(items: T[]) =>
  [...items].sort((a, b) => b.year - a.year);

const sortedPeerReviewed = byYearDesc(publicationsPeerReviewed);
const sortedBookChapters = byYearDesc(publicationsBookChapters);
const sortedMisc = byYearDesc(publicationsMisc);
const sortedPresentations = byYearDesc(presentations);
const sortedAwards = byYearDesc(awards);
const sortedTeaching = byYearDesc(teaching);
const sortedAcademicService = byYearDesc(academicService);
const sortedSelectedPrograms = byYearDesc(selectedPrograms);

const navItems = [
  { href: '#research', label: 'Research' },
  { href: '#publications', label: 'Publications' },
  { href: '#presentations', label: 'Presentations' },
  { href: '#projects', label: 'Projects & Grants' },
  { href: '#awards', label: 'Awards' },
  { href: '#teaching', label: 'Teaching' },
  { href: '#experience', label: 'Experience' },
  { href: '#education', label: 'Education' },
  { href: '#selected-programs', label: 'Selected Programs' },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name.en ?? profile.name.ja,
  alternateName: profile.name.ja,
  affiliation: profile.affiliations.map((a) => ({
    '@type': 'Organization',
    name: a.org,
  })),
  alumniOf: education.map((e) => ({
    '@type': 'CollegeOrUniversity',
    name: e.institutionJa,
  })),
  knowsAbout: researchInterests.map((i) => i.en ?? i.ja),
  url: 'https://waxogawa.jp/research/',
};
---

<BaseLayout
  title="Research"
  description="Research profile, publications, curatorial research, grants, presentations, and academic activities of Rakuki Ogawa."
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <div class="research-page">

    <nav class="research-nav" aria-label="研究ページ内ナビゲーション">
      <div class="research-nav-scroll">
        {navItems.map((item) => (
          <a href={item.href} class="research-nav-link">{item.label}</a>
        ))}
      </div>
    </nav>

    <!-- A. Research Profile / B. Research Interests / C. Current Research -->
    <section id="research" class="research-block">
      <div class="profile-header">
        <h1 class="profile-name">
          {profile.name.ja}
          {profile.name.en && <span class="profile-name-en">{profile.name.en}</span>}
        </h1>
        <ul class="profile-affil-list">
          {profile.affiliations.map((a) => (
            <li class="profile-affil-item">
              <span class="profile-affil-org">{a.org}</span>
              <span class="profile-affil-role">
                {a.role}{a.roleEn ? ` / ${a.roleEn}` : ''}
              </span>
            </li>
          ))}
        </ul>
      </div>

      <p class="profile-statement">{profile.statement}</p>

      <div class="interest-tags">
        {researchInterests.map((tag) => (
          <span class="interest-tag">
            {tag.ja}{tag.en ? ` / ${tag.en}` : ''}
          </span>
        ))}
      </div>

      <h2 class="section-heading">Current Research</h2>
      <div class="current-research-grid">
        {currentResearch.map((item) => (
          <div class="current-research-card">
            <h3 class="current-research-title">
              {item.title.ja}
              {item.title.en && <span class="current-research-title-en">{item.title.en}</span>}
            </h3>
            <p class="current-research-description">{item.description}</p>
            <div class="current-research-meta">
              {item.period && <span>{item.period}</span>}
              {item.location && <span>{item.location}</span>}
              {item.status && <span class="current-research-status">{item.status}</span>}
            </div>
            {item.link && (
              <a href={item.link.url} class="research-external-link" target="_blank" rel="noopener noreferrer">
                {item.link.label} ↗
              </a>
            )}
          </div>
        ))}
      </div>
    </section>

    <!-- Publications -->
    <section id="publications" class="research-block">
      <h2 class="section-heading">Publications</h2>

      <div class="pub-filter" role="group" aria-label="Publications フィルター">
        <button type="button" class="pub-filter-btn is-active" data-filter="all">All</button>
        <button type="button" class="pub-filter-btn" data-filter="peer-reviewed">Peer-reviewed</button>
        <button type="button" class="pub-filter-btn" data-filter="book-chapter">Book Chapters</button>
        <button type="button" class="pub-filter-btn" data-filter="essay">Essay</button>
      </div>

      <h3 class="subsection-heading" data-pub-group="peer-reviewed">Peer-reviewed Articles</h3>
      <ul class="timeline-list" data-pub-group="peer-reviewed">
        {sortedPeerReviewed.map((pub) => {
          const meta = `${pub.authors.join('・')} — ${pub.journal} ${pub.volume}(${pub.issue}), pp.${pub.pages}, ${pub.year}`;
          return (
            <li
              class="timeline-row research-popup-trigger"
              data-pub-type="peer-reviewed"
              data-popup-kind="Peer-reviewed Article"
              data-popup-title={pub.titleEn ? `${pub.titleJa} / ${pub.titleEn}` : pub.titleJa}
              data-popup-meta={meta}
              data-popup-abstract={pub.abstract ?? ''}
              data-popup-url={pub.url ?? ''}
              data-popup-doi={pub.doi ?? ''}
              data-popup-pdf={pub.pdf ?? ''}
            >
              <span class="timeline-year">{pub.year}</span>
              <div class="timeline-content">
                <p class="pub-title">{pub.titleJa}</p>
                <p class="pub-meta">{meta}</p>
                <p class="pub-tags">
                  {pub.peerReviewed && <span class="pub-tag">査読有り</span>}
                  {pub.firstAuthor && <span class="pub-tag">筆頭著者</span>}
                </p>
              </div>
            </li>
          );
        })}
      </ul>

      <h3 class="subsection-heading" data-pub-group="book-chapter">Book Chapters</h3>
      <ul class="timeline-list" data-pub-group="book-chapter">
        {sortedBookChapters.map((b) => {
          const meta = `${b.editors.join('・')} 編 — ${b.publisher}${b.date ? `, ${b.date}` : ''}${b.pages ? ` — pp.${b.pages}` : ''}`;
          return (
            <li
              class="timeline-row research-popup-trigger"
              data-pub-type="book-chapter"
              data-popup-kind="Book Chapter"
              data-popup-title={b.titleJa}
              data-popup-meta={meta}
              data-popup-abstract={b.abstract ?? (b.isbn ? `ISBN ${b.isbn}` : '')}
              data-popup-links={b.links ? JSON.stringify(b.links) : ''}
            >
              <span class="timeline-year">{b.year}</span>
              <div class="timeline-content">
                <p class="pub-title">{b.titleJa}</p>
                <p class="pub-meta">{meta}</p>
                <p class="pub-tags">
                  {b.role && <span class="pub-tag">{b.role}</span>}
                  {b.isbn && <span class="pub-tag">ISBN {b.isbn}</span>}
                </p>
              </div>
            </li>
          );
        })}
      </ul>

      <h3 class="subsection-heading" data-pub-group="essay">Essays / MISC</h3>
      <ul class="timeline-list" data-pub-group="essay">
        {sortedMisc.map((pub) => {
          const meta = `${pub.publication}${pub.date ? ` — ${pub.date}` : ''}`;
          return (
            <li
              class="timeline-row research-popup-trigger"
              data-pub-type="essay"
              data-popup-kind="Essay / MISC"
              data-popup-title={pub.titleJa}
              data-popup-meta={meta}
              data-popup-abstract={pub.abstract ?? ''}
              data-popup-url={pub.url ?? ''}
              data-popup-pdf={pub.pdf ?? ''}
            >
              <span class="timeline-year">{pub.year}</span>
              <div class="timeline-content">
                <p class="pub-title">{pub.titleJa}</p>
                <p class="pub-meta">{meta}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- Presentations -->
    <section id="presentations" class="research-block">
      <h2 class="section-heading">Presentations</h2>
      <ul class="timeline-list">
        {sortedPresentations.map((p) => {
          const meta = [p.institution, p.event].filter(Boolean).join(' — ') + (p.date ? ` — ${p.date}` : '');
          return (
            <li
              class="timeline-row research-popup-trigger"
              data-popup-kind="Presentation"
              data-popup-title={p.title.en ? `${p.title.ja} / ${p.title.en}` : p.title.ja}
              data-popup-meta={meta}
              data-popup-abstract={p.abstract ?? ''}
              data-popup-url={p.url ?? ''}
              data-popup-doi={p.doi ?? ''}
              data-popup-pdf={p.pdf ?? ''}
            >
              <span class="timeline-year">{p.year}</span>
              <div class="timeline-content">
                <p class="pub-title">
                  {p.title.ja}
                  {p.title.en && <span class="pub-title-en">{p.title.en}</span>}
                </p>
                <p class="pub-meta">{meta}</p>
                {p.type && <p class="pub-tags"><span class="pub-tag">{p.type}</span></p>}
              </div>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- Research Projects & Grants -->
    <section id="projects" class="research-block">
      <h2 class="section-heading">Research Projects & Grants</h2>
      <div class="grant-list">
        {grants.map((g) => {
          const meta = `${g.org}${g.program ? ` — ${g.program}` : ''} — ${[g.startDate, g.endDate].filter(Boolean).join(' – ')} — PI: ${g.pi}`;
          return (
            <div
              class="grant-card research-popup-trigger"
              data-popup-kind="Research Project / Grant"
              data-popup-title={g.title}
              data-popup-meta={meta}
              data-popup-abstract={g.description ?? ''}
              data-popup-url={g.link ?? ''}
              data-popup-doi={g.doi ?? ''}
              data-popup-pdf={g.pdf ?? ''}
            >
              <span class="grant-period">{g.periodLabel}</span>
              <div class="grant-content">
                <p class="grant-title">{g.title}</p>
                <p class="pub-meta">
                  {g.org}{g.program ? ` — ${g.program}` : ''}
                </p>
                <p class="pub-meta">
                  {[g.startDate, g.endDate].filter(Boolean).join(' – ')}
                </p>
                <p class="grant-pi">PI: {g.pi}</p>
                {g.description && <p class="pub-meta">{g.description}</p>}
                {g.amount && <p class="pub-meta">{g.amount}</p>}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Awards -->
    <section id="awards" class="research-block">
      <h2 class="section-heading">Awards</h2>
      <ul class="timeline-list">
        {sortedAwards.map((a) => {
          const meta = `${a.org}${a.date ? ` — ${a.date}` : ''}`;
          return (
            <li
              class="timeline-row research-popup-trigger"
              data-popup-kind="Award"
              data-popup-title={a.title}
              data-popup-meta={meta}
              data-popup-abstract={a.abstract ?? (a.workTitle ? `「${a.workTitle}」${a.recipients ? ' — ' + a.recipients.join(' / ') : ''}` : '')}
              data-popup-url={a.url ?? ''}
              data-popup-pdf={a.pdf ?? ''}
            >
              <span class="timeline-year">{a.year}</span>
              <div class="timeline-content">
                <p class="pub-title">{a.title}</p>
                <p class="pub-meta">{meta}</p>
                {a.workTitle && <p class="pub-meta">「{a.workTitle}」</p>}
                {a.recipients && <p class="pub-meta">{a.recipients.join(' / ')}</p>}
              </div>
            </li>
          );
        })}
      </ul>
    </section>

    <!-- Teaching -->
    <section id="teaching" class="research-block">
      <h2 class="section-heading">Teaching</h2>
      <ul class="timeline-list">
        {sortedTeaching.map((t) => (
          <li class="timeline-row">
            <span class="timeline-year">{t.year}</span>
            <div class="timeline-content">
              <p class="pub-title">{t.title}</p>
              <p class="pub-meta">
                {t.institution}
                {t.role ? ` — ${t.role}` : ''}
                {t.period ? ` — ${t.period}` : ''}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Professional / Academic Experience -->
    <section id="experience" class="research-block">
      <h2 class="section-heading">Professional / Academic Experience</h2>
      <ul class="timeline-list">
        {experience.map((e) => (
          <li class="timeline-row">
            <span class="timeline-year">{e.periodLabel}</span>
            <div class="timeline-content">
              <p class="pub-title">{e.org}{e.department ? ` — ${e.department}` : ''}</p>
              <p class="pub-meta">{e.role}</p>
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Education -->
    <section id="education" class="research-block">
      <h2 class="section-heading">Education</h2>
      <ul class="timeline-list">
        {education.map((e) => (
          <li class="timeline-row">
            <span class="timeline-year">{e.periodLabel}</span>
            <div class="timeline-content">
              <p class="pub-title">{e.institutionJa}</p>
              {e.institutionEn && <p class="pub-meta">{e.institutionEn}</p>}
              {e.departmentJa && <p class="pub-meta">{e.departmentJa}</p>}
              {(e.startDate || e.endDate) && (
                <p class="pub-meta">{[e.startDate, e.endDate].filter(Boolean).join(' – ')}</p>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Academic Service -->
    <section id="academic-service" class="research-block">
      <h2 class="section-heading">Academic Service</h2>
      <ul class="timeline-list">
        {sortedAcademicService.map((s) => (
          <li class="timeline-row">
            <span class="timeline-year">{s.year}</span>
            <div class="timeline-content">
              <p class="pub-title">{s.title}</p>
              <p class="pub-meta">
                {s.role}{s.institution ? ` — ${s.institution}` : ''}
              </p>
              {(s.startDate || s.endDate) && (
                <p class="pub-meta">{[s.startDate, s.endDate].filter(Boolean).join(' – ')}</p>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>

    <!-- Selected Programs / Fellowships -->
    <section id="selected-programs" class="research-block">
      <h2 class="section-heading">Selected Programs</h2>
      <ul class="timeline-list">
        {sortedSelectedPrograms.map((p) => {
          const meta = `${p.org}${p.role ? ` — ${p.role}` : ''}`;
          return (
            <li
              class="timeline-row research-popup-trigger"
              data-popup-kind="Selected Program"
              data-popup-title={p.title}
              data-popup-meta={meta}
              data-popup-abstract={p.abstract ?? ''}
              data-popup-url={p.url ?? ''}
            >
              <span class="timeline-year">{p.year}</span>
              <div class="timeline-content">
                <p class="pub-title">{p.title}</p>
                <p class="pub-meta">{meta}</p>
              </div>
            </li>
          );
        })}
      </ul>
    </section>

    <section class="research-block">
      <p class="research-text">researchmap にて業績一覧を公開しています。</p>
      <a
        href="https://researchmap.jp/waxogawa"
        class="research-external-link"
        target="_blank"
        rel="noopener noreferrer"
      >
        researchmap ↗
      </a>
    </section>

  </div>

  <!-- Shared detail popup for Publications / Presentations / Grants / Awards -->
  <div class="research-popup" id="research-popup" role="dialog" aria-modal="true" aria-hidden="true" aria-labelledby="research-popup-title">
    <div class="research-popup-panel">
      <button type="button" class="research-popup-close" id="research-popup-close" aria-label="閉じる">×</button>
      <p class="research-popup-eyebrow" id="research-popup-eyebrow"></p>
      <h3 class="research-popup-title" id="research-popup-title"></h3>
      <p class="research-popup-meta" id="research-popup-meta"></p>
      <p class="research-popup-abstract" id="research-popup-abstract"></p>
      <div class="research-popup-links" id="research-popup-links"></div>
    </div>
  </div>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.pub-filter-btn');
  const groups = document.querySelectorAll<HTMLElement>('[data-pub-group]');
  const rows = document.querySelectorAll<HTMLElement>('[data-pub-type]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const filter = btn.dataset.filter;

      if (filter === 'all') {
        groups.forEach((g) => (g.style.display = ''));
        rows.forEach((r) => (r.style.display = ''));
        return;
      }

      groups.forEach((g) => {
        g.style.display = g.dataset.pubGroup === filter ? '' : 'none';
      });
      rows.forEach((r) => {
        r.style.display = r.dataset.pubType === filter ? '' : 'none';
      });
    });
  });

  // ── Shared "detail" popup for Publications / Presentations / Grants / Awards ──
  const popup = document.getElementById('research-popup');
  const popupClose = document.getElementById('research-popup-close');
  const popupEyebrow = document.getElementById('research-popup-eyebrow');
  const popupTitle = document.getElementById('research-popup-title');
  const popupMeta = document.getElementById('research-popup-meta');
  const popupAbstract = document.getElementById('research-popup-abstract');
  const popupLinks = document.getElementById('research-popup-links');
  const triggers = document.querySelectorAll<HTMLElement>('.research-popup-trigger');

  function addPopupLink(href: string | undefined, label: string) {
    if (!href || !popupLinks) return;
    const a = document.createElement('a');
    a.href = href;
    a.target = '_blank';
    a.rel = 'noopener noreferrer';
    a.textContent = label;
    popupLinks.appendChild(a);
  }

  function openResearchPopup(trigger: HTMLElement) {
    if (!popup || !popupTitle || !popupMeta || !popupAbstract || !popupLinks || !popupEyebrow) return;
    const d = trigger.dataset;

    popupEyebrow.textContent = d.popupKind ?? '';
    popupTitle.textContent = d.popupTitle ?? '';
    popupMeta.textContent = d.popupMeta ?? '';
    popupAbstract.textContent = d.popupAbstract ?? '';
    popupLinks.innerHTML = '';

    addPopupLink(d.popupUrl, '公式サイト ↗');
    if (d.popupDoi) {
      const doiHref = d.popupDoi.startsWith('http') ? d.popupDoi : `https://doi.org/${d.popupDoi}`;
      addPopupLink(doiHref, `DOI: ${d.popupDoi} ↗`);
    }
    addPopupLink(d.popupPdf, 'PDF ↗');
    if (d.popupLinks) {
      try {
        const extraLinks: { label: string; url: string }[] = JSON.parse(d.popupLinks);
        extraLinks.forEach((l) => addPopupLink(l.url, `${l.label} ↗`));
      } catch {
        // ignore malformed data
      }
    }

    popup.classList.add('is-open');
    popup.setAttribute('aria-hidden', 'false');
    document.body.style.overflow = 'hidden';
  }

  function closeResearchPopup() {
    popup?.classList.remove('is-open');
    popup?.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
  }

  triggers.forEach((trigger) => {
    trigger.setAttribute('role', 'button');
    trigger.setAttribute('tabindex', '0');

    trigger.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) return; // let real links behave normally
      openResearchPopup(trigger);
    });

    trigger.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('a')) return;
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        openResearchPopup(trigger);
      }
    });
  });

  popupClose?.addEventListener('click', closeResearchPopup);
  popup?.addEventListener('click', (e) => {
    if (e.target === popup) closeResearchPopup();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeResearchPopup();
  });
</script>

<style>
  .research-page {
    max-width: var(--width-site);
    margin-inline: auto;
    padding-inline: var(--pad-h);
  }

  /* ── Sticky section nav ── */
  .research-nav {
    position: sticky;
    top: 73px;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 56px;
    z-index: 5;
  }

  .research-nav-scroll {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    padding-block: 14px;
    scrollbar-width: none;
  }

  .research-nav-scroll::-webkit-scrollbar {
    display: none;
  }

  .research-nav-link {
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-muted);
    white-space: nowrap;
    transition: color var(--transition);
  }

  .research-nav-link:hover {
    color: var(--color-accent);
  }

  /* ── Blocks ── */
  .research-block {
    padding-block: 56px;
    border-bottom: 1px solid var(--color-border);
    scroll-margin-top: 130px;
  }

  .research-block:last-child {
    border-bottom: none;
  }

  .section-heading {
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
    margin-bottom: 28px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-border);
  }

  .subsection-heading {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text);
    margin-block: 32px 12px;
  }

  .subsection-heading:first-of-type {
    margin-top: 0;
  }

  /* ── Profile ── */
  .profile-header {
    margin-bottom: 24px;
  }

  .profile-name {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 500;
    line-height: 1.3;
    margin-bottom: 16px;
  }

  .profile-name-en {
    display: block;
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--color-muted);
    margin-top: 4px;
  }

  .profile-affil-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .profile-affil-item {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.85rem;
    flex-wrap: wrap;
  }

  .profile-affil-org {
    color: var(--color-text);
  }

  .profile-affil-role {
    color: var(--color-muted);
    white-space: nowrap;
  }

  .profile-statement {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    line-height: 2.0;
    color: var(--color-text);
    max-width: 640px;
    margin-bottom: 32px;
  }

