---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TermGraphPanel from '../../components/TermGraphPanel.astro';
import { buildTermGraph } from '../../lib/termGraph.ts';

export const prerender = true;

export async function getStaticPaths() {
  const [entries, graph] = await Promise.all([
    getCollection('works', ({ data }) => data.draft !== true),
    buildTermGraph(),
  ]);

  return entries.map((entry) => ({
    params: { slug: entry.id.replace(/\.md$/, '') },
    props: { entry, graph },
  }));
}

const { entry, graph } = Astro.props;
const { Content } = await render(entry);

const pageId = `works/${entry.id.replace(/\.md$/, '')}`;
const pageData = graph.pages[pageId];
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <div class="page-with-sidebar">

    <div class="page-main">
      <div class="article-meta">
        <a href="/works/" class="article-back">← Works</a>
        <h1 class="article-title">{entry.data.title}</h1>
        <time class="article-date" datetime={entry.data.date.toISOString()}>
          {entry.data.date.toLocaleDateString('ja-JP')}
        </time>
        {entry.data.description && (
          <p class="article-description">{entry.data.description}</p>
        )}
        {entry.data.tags.length > 0 && (
          <div class="works-card-tags" style="margin-top: 16px;">
            {entry.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
        )}
      </div>

      <div class="article-body">
        <Content />
      </div>
    </div>

    <TermGraphPanel pageData={pageData} graph={graph} />

  </div>
</BaseLayout>

<style>
  .page-with-sidebar {
    display: grid;
    grid-template-columns: 1fr 288px;
    gap: 0 48px;
    max-width: calc(var(--width-article) + 336px);
    margin-inline: auto;
    padding-inline: var(--pad-h);
    align-items: start;
  }

  .page-main {
    min-width: 0;
  }

  @media (max-width: 960px) {
    .page-with-sidebar {
      grid-template-columns: 1fr;
    }
  }
</style>
