---
---
<div id="floating-network" aria-hidden="true">
  <svg id="network-svg" aria-hidden="true"></svg>
</div>

<div id="term-popup" role="dialog" aria-modal="true" aria-label="ページへの遷移">
  <p id="term-popup-label"></p>
  <ul id="term-popup-links"></ul>
  <button id="term-popup-close" aria-label="閉じる">×</button>
</div>

<style>
  /*
   * Full-viewport overlay: nodes can be dragged anywhere without clipping.
   * z-index 5 sits above home-container (z-index:1) and below site-header (z-index:10).
   */
  #floating-network {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 5;
    opacity: 0.88;
    mix-blend-mode: multiply;
    pointer-events: none;
    user-select: none;
  }

  #network-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* ── Term popup ── */
  #term-popup {
    display: none;
    position: fixed;
    z-index: 300;
    background: var(--color-bg);
    border: 1px solid var(--color-text);
    padding: 14px 18px 16px;
    min-width: 160px;
    max-width: 240px;
    box-shadow: 2px 2px 0 var(--color-text);
    pointer-events: auto;
  }

  #term-popup-label {
    font-size: 0.70rem;
    font-weight: 500;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border);
    line-height: 1.5;
  }

  #term-popup-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #term-popup-links li a {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: 0.03em;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 0;
    transition: opacity 0.14s;
  }

  #term-popup-links li a::after {
    content: "→";
    font-size: 0.80em;
    color: var(--color-muted);
  }

  #term-popup-links li a:hover { opacity: 0.55; }

  #term-popup-close {
    position: absolute;
    top: 6px;
    right: 8px;
    background: none;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    padding: 2px 4px;
    transition: color 0.14s;
  }
  #term-popup-close:hover { color: var(--color-text); }

  @media (prefers-color-scheme: dark) {
    #floating-network { mix-blend-mode: screen; opacity: 0.52; }
  }

  @media (max-width: 900px) {
    #floating-network { display: none; }
    #term-popup       { display: none !important; }
  }
</style>

<script>
// All SVG element styles set directly in JS — Astro scoped CSS does not
// reach dynamically created elements (no data-astro-cid-* attribute).
//
// Physics model: Kuramoto phase-synchronization × mycelial edge growth × semantic
// repulsion. Each term is an oscillator (theta, omega). A graph-derived similarity
// S[i][j] (shared links + shared neighbours + layer proximity) drives three things:
//   - Kuramoto coupling sign/strength (close terms pull into phase, far terms push apart)
//   - mycelium edge weight A[i][j], which grows where terms are close in phase and
//     space, decays otherwise, and occasionally seeds new exploratory threads
//   - spatial repulsion, keeping semantically distant terms apart
// Drag/click/popup navigation is unchanged from the previous implementation.

const BLUE = "#0000ff";
const TAU  = Math.PI * 2;

const LAYER = {
  fontSize: ["13px", "10.5px", "8.5px"],
  opacity:  [0.90,   0.68,     0.46],
};

const TERMS = [
  { id: "curation",     label: ["curation",           "キュレーション"],      layer: 0 },
  { id: "anthropology", label: ["anthropology",        "人類学"],             layer: 0 },
  { id: "care",         label: ["care",                "ケア"],               layer: 0 },
  { id: "exhibition",   label: ["exhibition space",    "展示空間"],           layer: 0 },
  { id: "conversion",   label: ["conditions of conv.", "変換条件"],           layer: 0 },
  { id: "cochlear",     label: ["cochlear implant",    "人工内耳"],           layer: 1 },
  { id: "voice",        label: ["voice",               "声"],                 layer: 1 },
  { id: "silence",      label: ["silence",             "沈黙"],               layer: 1 },
  { id: "translation",  label: ["translation",         "翻訳"],               layer: 1 },
  { id: "caption",      label: ["caption",             "キャプション"],       layer: 1 },
  { id: "text",         label: ["text",                "テクスト"],           layer: 1 },
  { id: "body",         label: ["body",                "身体"],               layer: 1 },
  { id: "eastasia",     label: ["East Asia",           "東アジア"],           layer: 2 },
  { id: "death",        label: ["death",               "死"],                 layer: 2 },
  { id: "online",       label: ["online space",        "オンライン空間"],     layer: 2 },
  { id: "christianity", label: ["Christian paradigm",  "キリスト教的範例性"], layer: 2 },
  { id: "market",       label: ["market economy",      "市場経済"],           layer: 2 },
  { id: "institution",  label: ["institution",         "制度"],               layer: 2 },
  { id: "memory",       label: ["memory",              "記憶"],               layer: 2 },
  { id: "imagination",  label: ["imagination",         "想像力"],             layer: 2 },
  { id: "fiction",      label: ["make-believe",        "フィクション"],       layer: 2 },
  { id: "poetics",      label: ["poetics",             "詩学"],               layer: 2 },
  { id: "accessibility",label: ["accessibility",       "アクセシビリティ"],   layer: 2 },
];

const LINKS = [
  ["curation",    "exhibition"], ["curation",    "conversion"],
  ["curation",    "institution"],["curation",    "memory"],
  ["curation",    "imagination"],["anthropology","translation"],
  ["anthropology","eastasia"],   ["anthropology","poetics"],
  ["care",        "body"],       ["care",        "accessibility"],
  ["care",        "cochlear"],   ["translation", "caption"],
  ["translation", "silence"],    ["translation", "cochlear"],
  ["caption",     "exhibition"], ["voice",       "silence"],
  ["voice",       "text"],       ["text",        "fiction"],
  ["fiction",     "imagination"],["death",       "online"],
  ["christianity","market"],     ["conversion",  "institution"],
  ["conversion",  "accessibility"],["body",      "cochlear"],
  ["memory",      "exhibition"], ["institution", "market"],
  ["poetics",     "fiction"],
];

const PAGE_LABELS = {
  "/exhibitions/": "Exhibitions",
  "/writings/":    "Writings",
  "/works/":       "Works",
  "/research/":    "Research",
  "/about/":       "About",
  "/diary/":       "Diary",
};

const TERM_PAGES = {
  curation:     ["/exhibitions/", "/research/", "/about/"],
  anthropology: ["/research/",    "/writings/"],
  care:         ["/exhibitions/", "/research/"],
  exhibition:   ["/exhibitions/", "/works/"],
  conversion:   ["/research/",    "/about/"],
  cochlear:     ["/about/",       "/research/"],
  voice:        ["/writings/",    "/research/"],
  silence:      ["/writings/",    "/exhibitions/"],
  translation:  ["/writings/",    "/research/"],
  caption:      ["/exhibitions/", "/works/"],
  text:         ["/writings/",    "/research/"],
  body:         ["/research/",    "/writings/"],
  eastasia:     ["/research/",    "/exhibitions/"],
  death:        ["/research/",    "/writings/"],
  online:       ["/research/",    "/works/"],
  christianity: ["/research/"],
  market:       ["/research/",    "/exhibitions/"],
  institution:  ["/research/",    "/exhibitions/"],
  memory:       ["/exhibitions/", "/writings/"],
  imagination:  ["/writings/",    "/research/"],
  fiction:      ["/writings/",    "/research/"],
  poetics:      ["/writings/",    "/research/"],
  accessibility:["/research/",    "/exhibitions/", "/works/"],
};

// ── Kuramoto × mycelium × repulsion parameters ────────────
const K         = 0.42;  // Kuramoto coupling gain
const NEG_SYNC  = 0.55;  // negative coupling strength for semantically distant pairs
const ALPHA     = 0.012; // mycelium growth rate
const BETA      = 0.032; // mycelium decay rate
const GAMMA     = 0.032; // phase-sync reinforcement of edge weight
const DRIFT     = 0.43;  // drift speed
const REPULSION = 0.9;   // semantic repulsion strength

// ── Graph-derived semantic similarity matrix ──────────────
const ids      = TERMS.map(t => t.id);
const N        = ids.length;
const idIndex  = Object.fromEntries(ids.map((id, i) => [id, i]));

const neighborSets = ids.map(() => new Set());
LINKS.forEach(([a, b]) => {
  neighborSets[idIndex[a]].add(idIndex[b]);
  neighborSets[idIndex[b]].add(idIndex[a]);
});

function jaccard(setA, setB) {
  if (setA.size === 0 && setB.size === 0) return 0;
  let inter = 0;
  setA.forEach(v => { if (setB.has(v)) inter++; });
  const union = setA.size + setB.size - inter;
  return union === 0 ? 0 : inter / union;
}

const S = Array.from({ length: N }, () => new Array(N).fill(0));
for (let i = 0; i < N; i++) {
  S[i][i] = 1;
  for (let j = i + 1; j < N; j++) {
    const linked = neighborSets[i].has(j);
    const jac    = jaccard(neighborSets[i], neighborSets[j]);
    let s = linked ? 0.80 : jac * 0.62;
    const layerDiff = Math.abs(TERMS[i].layer - TERMS[j].layer);
    s += layerDiff === 0 ? 0.05 : layerDiff === 2 ? -0.05 : 0;
    s = Math.max(0, Math.min(1, s));
    S[i][j] = S[j][i] = s;
  }
}

// Mycelium edge-weight matrix, seeded from the curated LINKS and left free to
// grow, decay, and occasionally sprout new threads between synced terms.
const A = Array.from({ length: N }, () => new Array(N).fill(0));
function seedMycelium() {
  for (const row of A) row.fill(0);
  LINKS.forEach(([a, b]) => {
    const i = idIndex[a], j = idIndex[b];
    A[i][j] = A[j][i] = 0.34 + Math.random() * 0.08;
  });
}

// ── DOM refs ─────────────────────────────────────────────
const svg      = document.getElementById("network-svg");
const container= document.getElementById("floating-network");
const popup    = document.getElementById("term-popup");
const popLabel = document.getElementById("term-popup-label");
const popLinks = document.getElementById("term-popup-links");
const popClose = document.getElementById("term-popup-close");

if (svg && container && popup) {
  const state   = {}; // per-term physics state: bx,by (home anchor), x,y,vx,vy,theta,omega
  const nodeEls = {};
  let lines = []; // { i, j, el }
  let rafId = 0;
  let W = 0, H = 0;
  let lambda = 200;
  let hoveredId = null;

  let draggingId      = null;
  let dragStartClient = null;
  let dragOffsetX     = 0;
  let dragOffsetY     = 0;
  const DRAG_PX = 5;

  let mouse = { x: null, y: null };

  function rnd(min, max) { return Math.random() * (max - min) + min; }

  // SVG element coordinates = client coordinates when container is fixed inset:0
  function svgCoords(clientX, clientY) {
    const rect = svg.getBoundingClientRect();
    return {
      x: (clientX - rect.left) * (W / (rect.width  || W)),
      y: (clientY - rect.top)  * (H / (rect.height || H)),
    };
  }

  // Convert SVG position back to client coordinates (for popup placement)
  function svgToClient(svgX, svgY) {
    const rect = svg.getBoundingClientRect();
    return {
      x: rect.left + svgX * (rect.width  / W),
      y: rect.top  + svgY * (rect.height / H),
    };
  }

  function mkEl(tag) {
    return document.createElementNS("http://www.w3.org/2000/svg", tag);
  }

  // ── Build ────────────────────────────────────────────────
  function build() {
    W = container.clientWidth  || window.innerWidth;
    H = container.clientHeight || window.innerHeight;
    lambda = Math.min(W, H) * 0.22;

    svg.innerHTML = "";
    for (const k in nodeEls) delete nodeEls[k];
    for (const k in state)   delete state[k];

    // Center nodes in the right portion of the viewport,
    // matching the old right:3vw / width:40vw / top:10vh / height:72vh layout.
    const cx   = W * 0.74;
    const cy   = H * 0.44;
    const vmin = Math.min(W, H);

    const rings = [
      { rx: vmin * 0.110, ry: vmin * 0.095 },
      { rx: vmin * 0.210, ry: vmin * 0.185 },
      { rx: vmin * 0.275, ry: vmin * 0.245 },
    ];

    const byLayer = [[], [], []];
    TERMS.forEach(t => byLayer[t.layer].push(t));

    byLayer.forEach((nodes, li) => {
      const { rx, ry } = rings[li];
      nodes.forEach((t, i) => {
        const angle = (Math.PI * 2 * i / nodes.length) + rnd(-0.28, 0.28);
        const bx = cx + Math.cos(angle) * rx * rnd(0.82, 1.18);
        const by = cy + Math.sin(angle) * ry * rnd(0.82, 1.18);
        state[t.id] = {
          bx, by,
          x: bx, y: by,
          vx: 0, vy: 0,
          theta: rnd(0, TAU),
          omega: rnd(-0.010, 0.010),
        };
      });
    });

    seedMycelium();

    // Lines: pre-create for pairs with meaningful potential similarity; weight
    // and opacity are driven each frame by the live mycelium matrix.
    lines = [];
    for (let i = 0; i < N; i++) {
      for (let j = i + 1; j < N; j++) {
        if (S[i][j] < 0.18) continue;
        const el = mkEl("line");
        el.setAttribute("stroke", BLUE);
        el.setAttribute("fill", "none");
        el.style.pointerEvents = "none";
        svg.appendChild(el);
        lines.push({ i, j, el });
      }
    }

    // Text nodes
    TERMS.forEach(t => {
      const n = state[t.id];
      const [en, ja] = t.label;
      const hasLink  = Boolean(TERM_PAGES[t.id]);

      const textEl = mkEl("text");
      textEl.setAttribute("x",             n.x);
      textEl.setAttribute("y",             n.y);
      textEl.setAttribute("fill",          BLUE);
      textEl.setAttribute("opacity",       String(LAYER.opacity[t.layer]));
      textEl.setAttribute("font-size",     LAYER.fontSize[t.layer]);
      textEl.setAttribute("font-family",   "inherit");
      textEl.setAttribute("letter-spacing","0.04em");
      textEl.setAttribute("text-anchor",   "middle");
      textEl.style.pointerEvents = "auto";
      textEl.style.cursor        = hasLink ? "pointer" : "grab";
      textEl.dataset.termId      = t.id;

      const sp1 = mkEl("tspan");
      sp1.setAttribute("x", n.x); sp1.setAttribute("dy", "-0.65em");
      sp1.textContent = en;

      const sp2 = mkEl("tspan");
      sp2.setAttribute("x", n.x); sp2.setAttribute("dy", "1.35em");
      sp2.setAttribute("font-size", "0.93em");
      sp2.textContent = ja;

      textEl.appendChild(sp1);
      textEl.appendChild(sp2);
      svg.appendChild(textEl);
      nodeEls[t.id] = textEl;

      // Hover: highlight this node; connected mycelium threads are boosted
      // per-frame in the render loop (see below).
      textEl.addEventListener("mouseenter", () => { hoveredId = t.id; });
      textEl.addEventListener("mouseleave", () => { hoveredId = null; });
    });

    cancelAnimationFrame(rafId);
    rafId = requestAnimationFrame(animate);
  }

  // ── Kuramoto phase step ───────────────────────────────────
  function stepKuramoto() {
    const nextTheta = {};
    for (let i = 0; i < N; i++) {
      const a = state[ids[i]];
      let coupling = 0;
      for (let j = 0; j < N; j++) {
        if (i === j) continue;
        const b = state[ids[j]];
        const s = S[i][j];

        // Semantically close terms couple positively; distant terms couple
        // weakly negatively, so they also drift out of phase.
        const signed = s >= 0.48 ? s : -NEG_SYNC * Math.pow(0.48 - s, 1.2);
        const edge   = A[i][j] * s;
        const base   = 0.02 * signed;

        coupling += (edge + base) * Math.sin(b.theta - a.theta);
      }
      nextTheta[ids[i]] = a.theta + a.omega + K * 0.02 * coupling;
    }
    for (const id of ids) {
      state[id].theta = ((nextTheta[id] % TAU) + TAU) % TAU;
    }
  }

  // ── Mycelium edge growth / decay / exploration ────────────
  function updateMycelium() {
    for (let i = 0; i < N; i++) {
      for (let j = i + 1; j < N; j++) {
        const s = S[i][j];
        if (s < 0.12 && A[i][j] < 0.02) continue;

        const a = state[ids[i]], b = state[ids[j]];
        const dx = b.x - a.x, dy = b.y - a.y;
        const d  = Math.hypot(dx, dy);
        const semanticDistance = 1 - s;

        const spatialGrowth = Math.exp(-d / lambda);
        const G = spatialGrowth * Math.pow(s, 1.7);
        const phaseAlignment = (1 + Math.cos(b.theta - a.theta)) * 0.5;

        let next = A[i][j]
          + ALPHA * G
          + GAMMA * A[i][j] * (phaseAlignment - 0.42) * (0.30 + 0.90 * s)
          - BETA * A[i][j]
          - 0.015 * semanticDistance * A[i][j];

        if (s < 0.4) next -= BETA * (0.5 + semanticDistance);

        // Exploratory growth: an occasional new thread between terms that are
        // close in phase and meaning, even without a curated link.
        if (d < lambda * 1.5 && s > 0.5 && Math.random() < 0.0004) {
          next += 0.05 * Math.random() * s;
        }
        if (d > lambda * 2.1) next -= BETA * 1.3;

        next = Math.max(0, Math.min(1, next));
        A[i][j] = A[j][i] = next;
      }
    }
  }

  // ── Position integration: drift + home spring + mycelium pull + repulsion ──
  function updatePositions() {
    for (let i = 0; i < N; i++) {
      const id = ids[i];
      const n = state[id];
      if (id === draggingId) continue; // driven directly by pointer while dragging

      let ax = Math.cos(n.theta) * 0.0032 * DRIFT;
      let ay = Math.sin(n.theta) * 0.0032 * DRIFT;

      // weak return-to-home spring keeps the cloud within its ring region
      ax += (n.bx - n.x) * 0.00007;
      ay += (n.by - n.y) * 0.00007;

      for (let j = 0; j < N; j++) {
        if (i === j) continue;
        const m = state[ids[j]];
        const dx = m.x - n.x, dy = m.y - n.y;
        const d  = Math.max(1, Math.hypot(dx, dy));
        const ux = dx / d, uy = dy / d;

        const s = S[i][j];
        const semanticDistance = 1 - s;
        const edge = A[i][j];

        // mycelial tension: strong, semantically close edges draw gently together
        ax += ux * edge * s * 0.0009;
        ay += uy * edge * s * 0.0009;

        // semantic repulsion: distant terms push apart at close-to-mid range
        const repulsionRange = 60 + lambda * 0.6;
        if (d < repulsionRange) {
          const rangeFactor   = Math.pow(1 - d / repulsionRange, 1.25);
          const semanticRepel = Math.pow(Math.max(0, semanticDistance - 0.35), 1.3);
          const force = REPULSION * semanticRepel * rangeFactor * 0.018;
          ax -= ux * force;
          ay -= uy * force;
        }

        // local repulsion to prevent label overlap
        if (d < 46) {
          const push = (46 - d) / 46;
          ax -= ux * push * 0.006;
          ay -= uy * push * 0.006;
        }
      }

      if (mouse.x !== null) {
        const dx = mouse.x - n.x, dy = mouse.y - n.y;
        const d  = Math.max(1, Math.hypot(dx, dy));
        const radius = 130;
        if (d < radius) {
          const force = (1 - d / radius) * 0.05;
          ax += (dx / d) * force;
          ay += (dy / d) * force;
        }
      }

      n.vx = (n.vx + ax) * 0.965;
      n.vy = (n.vy + ay) * 0.965;

      const maxV = 0.55 + DRIFT * 0.5;
      const speed = Math.hypot(n.vx, n.vy);
      if (speed > maxV) {
        n.vx = (n.vx / speed) * maxV;
        n.vy = (n.vy / speed) * maxV;
      }

      n.x += n.vx;
      n.y += n.vy;
    }
  }

  // ── Animate ──────────────────────────────────────────────
  function animate() {
    stepKuramoto();
    updateMycelium();
    updatePositions();

    TERMS.forEach(t => {
      const n  = state[t.id];
      const el = nodeEls[t.id];
      if (!n || !el) return;

      const hovered = t.id === hoveredId;
      const pulse   = 0.85 + 0.15 * ((1 + Math.cos(n.theta)) * 0.5);

      el.setAttribute("x", n.x);
      el.setAttribute("y", n.y);
      el.setAttribute("opacity", hovered ? "1" : String(LAYER.opacity[t.layer] * pulse));
      el.setAttribute("font-weight", hovered ? "500" : "400");
      el.querySelectorAll("tspan").forEach(sp => sp.setAttribute("x", n.x));
    });

    for (const line of lines) {
      const { i, j, el } = line;
      const a = state[ids[i]], b = state[ids[j]];
      const s = S[i][j];
      const weight = A[i][j];

      el.setAttribute("x1", a.x); el.setAttribute("y1", a.y);
      el.setAttribute("x2", b.x); el.setAttribute("y2", b.y);

      const hovered = hoveredId !== null && (ids[i] === hoveredId || ids[j] === hoveredId);
      const baseOpacity = Math.min(0.50, weight * 0.55 * (0.35 + s));
      const baseWidth   = 0.35 + Math.pow(weight, 1.5) * 3.2 * (0.4 + s);

      el.setAttribute("opacity",      String(hovered ? Math.max(baseOpacity, 0.40) : baseOpacity));
      el.setAttribute("stroke-width", String(hovered ? Math.max(baseWidth, 0.85)   : baseWidth));
    }

    rafId = requestAnimationFrame(animate);
  }

  // ── Popup ────────────────────────────────────────────────
  function showPopup(termId, clientX, clientY) {
    const term  = TERMS.find(t => t.id === termId);
    const pages = TERM_PAGES[termId];
    if (!term || !pages?.length) return;

    popLabel.textContent = `${term.label[0]}  /  ${term.label[1]}`;
    popLinks.innerHTML   = "";
    pages.forEach(href => {
      const li = document.createElement("li");
      const a  = document.createElement("a");
      a.href        = href;
      a.textContent = PAGE_LABELS[href] || href;
      li.appendChild(a);
      popLinks.appendChild(li);
    });

    popup.style.visibility = "hidden";
    popup.style.display    = "block";

    requestAnimationFrame(() => {
      const r    = popup.getBoundingClientRect();
      let left   = clientX + 16;
      let top    = clientY - r.height / 2;
      if (left + r.width  > window.innerWidth  - 12) left = clientX - r.width - 16;
      if (left < 12)                                  left = 12;
      if (top  < 12)                                  top  = 12;
      if (top  + r.height > window.innerHeight - 12)  top  = window.innerHeight - r.height - 12;
      popup.style.left       = left + "px";
      popup.style.top        = top  + "px";
      popup.style.visibility = "visible";
    });
  }

  function hidePopup() {
    popup.style.display = "none";
  }

  popClose.addEventListener("click", hidePopup);

  // Show a random term popup on page load
  function showRandomPopup() {
    if (window.innerWidth <= 900) return;
    const linkable = TERMS.filter(t => TERM_PAGES[t.id]?.length > 0);
    if (!linkable.length) return;
    const term = linkable[Math.floor(Math.random() * linkable.length)];
    const node = state[term.id];
    if (!node) return;
    const { x, y } = svgToClient(node.x, node.y);
    showPopup(term.id, x, y);
  }

  // ── Pointer events ───────────────────────────────────────
  document.addEventListener("pointerdown", e => {
    if (popup.style.display === "block" && !popup.contains(e.target)) {
      hidePopup();
    }

    const textEl = e.target.closest ? e.target.closest("[data-term-id]") : null;
    const id     = textEl?.dataset?.termId;
    if (!id || !state[id]) return;

    draggingId      = id;
    dragStartClient = { x: e.clientX, y: e.clientY };
    textEl.style.cursor = "grabbing";

    const svgP  = svgCoords(e.clientX, e.clientY);
    dragOffsetX = svgP.x - state[id].x;
    dragOffsetY = svgP.y - state[id].y;
    e.preventDefault();
  });

  document.addEventListener("pointermove", e => {
    mouse = svgCoords(e.clientX, e.clientY);
    if (!draggingId || !dragStartClient) return;
    const dx = e.clientX - dragStartClient.x;
    const dy = e.clientY - dragStartClient.y;
    if (Math.sqrt(dx * dx + dy * dy) < DRAG_PX) return;
    const { x, y } = svgCoords(e.clientX, e.clientY);
    const n = state[draggingId];
    n.x = x - dragOffsetX;
    n.y = y - dragOffsetY;
    n.vx = 0; n.vy = 0;
  });

  document.addEventListener("pointerup", e => {
    if (!draggingId) return;
    const id = draggingId;
    const dx = e.clientX - (dragStartClient?.x ?? e.clientX);
    const dy = e.clientY - (dragStartClient?.y ?? e.clientY);
    const wasDrag = Math.sqrt(dx * dx + dy * dy) >= DRAG_PX;

    if (nodeEls[id]) nodeEls[id].style.cursor = TERM_PAGES[id] ? "pointer" : "grab";
    // anchor the home spring to the dropped location so it doesn't snap back
    state[id].bx    = state[id].x;
    state[id].by    = state[id].y;
    draggingId      = null;
    dragStartClient = null;

    if (!wasDrag && TERM_PAGES[id]) {
      showPopup(id, e.clientX, e.clientY);
    }
  });

  // ── Init ─────────────────────────────────────────────────
  function waitAndBuild() {
    if (container.clientWidth === 0) { requestAnimationFrame(waitAndBuild); return; }
    build();
    setTimeout(showRandomPopup, 800);
  }
  requestAnimationFrame(waitAndBuild);

  let resizeTimer = 0;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => { draggingId = null; hidePopup(); build(); }, 200);
  });
}
</script>
