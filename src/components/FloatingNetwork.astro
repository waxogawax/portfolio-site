---
---
<div id="floating-network" aria-hidden="true">
  <svg id="network-svg" aria-hidden="true"></svg>
</div>

<div id="term-popup" role="dialog" aria-modal="true" aria-label="ページへの遷移">
  <p id="term-popup-label"></p>
  <ul id="term-popup-links"></ul>
  <button id="term-popup-close" aria-label="閉じる">×</button>
</div>

<style>
  /*
   * Full-viewport overlay: nodes can be dragged anywhere without clipping.
   * z-index 5 sits above home-container (z-index:1) and below site-header (z-index:10).
   */
  #floating-network {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    z-index: 5;
    opacity: 0.88;
    mix-blend-mode: multiply;
    pointer-events: none;
    user-select: none;
  }

  #network-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* ── Term popup ── */
  #term-popup {
    display: none;
    position: fixed;
    z-index: 300;
    background: var(--color-bg);
    border: 1px solid var(--color-text);
    padding: 14px 18px 16px;
    min-width: 160px;
    max-width: 240px;
    box-shadow: 2px 2px 0 var(--color-text);
    pointer-events: auto;
  }

  #term-popup-label {
    font-size: 0.70rem;
    font-weight: 500;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--color-text);
    margin-bottom: 10px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--color-border);
    line-height: 1.5;
  }

  #term-popup-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  #term-popup-links li a {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: 0.03em;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 3px 0;
    transition: opacity 0.14s;
  }

  #term-popup-links li a::after {
    content: "→";
    font-size: 0.80em;
    color: var(--color-muted);
  }

  #term-popup-links li a:hover { opacity: 0.55; }

  #term-popup-close {
    position: absolute;
    top: 6px;
    right: 8px;
    background: none;
    border: none;
    color: var(--color-muted);
    cursor: pointer;
    font-size: 1rem;
    line-height: 1;
    padding: 2px 4px;
    transition: color 0.14s;
  }
  #term-popup-close:hover { color: var(--color-text); }

  @media (prefers-color-scheme: dark) {
    #floating-network { mix-blend-mode: screen; opacity: 0.52; }
  }

  @media (max-width: 900px) {
    #floating-network { display: none; }
    #term-popup       { display: none !important; }
  }
</style>

<script>
// All SVG element styles set directly in JS — Astro scoped CSS does not
// reach dynamically created elements (no data-astro-cid-* attribute).

const BLUE = "#0000ff";

const LAYER = {
  fontSize: ["13px", "10.5px", "8.5px"],
  opacity:  [0.90,   0.68,     0.46],
};

const TERMS = [
  { id: "curation",     label: ["curation",           "キュレーション"],      layer: 0 },
  { id: "anthropology", label: ["anthropology",        "人類学"],             layer: 0 },
  { id: "care",         label: ["care",                "ケア"],               layer: 0 },
  { id: "exhibition",   label: ["exhibition space",    "展示空間"],           layer: 0 },
  { id: "conversion",   label: ["conditions of conv.", "変換条件"],           layer: 0 },
  { id: "cochlear",     label: ["cochlear implant",    "人工内耳"],           layer: 1 },
  { id: "voice",        label: ["voice",               "声"],                 layer: 1 },
  { id: "silence",      label: ["silence",             "沈黙"],               layer: 1 },
  { id: "translation",  label: ["translation",         "翻訳"],               layer: 1 },
  { id: "caption",      label: ["caption",             "キャプション"],       layer: 1 },
  { id: "text",         label: ["text",                "テクスト"],           layer: 1 },
  { id: "body",         label: ["body",                "身体"],               layer: 1 },
  { id: "eastasia",     label: ["East Asia",           "東アジア"],           layer: 2 },
  { id: "death",        label: ["death",               "死"],                 layer: 2 },
  { id: "online",       label: ["online space",        "オンライン空間"],     layer: 2 },
  { id: "christianity", label: ["Christian paradigm",  "キリスト教的範例性"], layer: 2 },
  { id: "market",       label: ["market economy",      "市場経済"],           layer: 2 },
  { id: "institution",  label: ["institution",         "制度"],               layer: 2 },
  { id: "memory",       label: ["memory",              "記憶"],               layer: 2 },
  { id: "imagination",  label: ["imagination",         "想像力"],             layer: 2 },
  { id: "fiction",      label: ["make-believe",        "フィクション"],       layer: 2 },
  { id: "poetics",      label: ["poetics",             "詩学"],               layer: 2 },
  { id: "accessibility",label: ["accessibility",       "アクセシビリティ"],   layer: 2 },
];

const LINKS = [
  ["curation",    "exhibition"], ["curation",    "conversion"],
  ["curation",    "institution"],["curation",    "memory"],
  ["curation",    "imagination"],["anthropology","translation"],
  ["anthropology","eastasia"],   ["anthropology","poetics"],
  ["care",        "body"],       ["care",        "accessibility"],
  ["care",        "cochlear"],   ["translation", "caption"],
  ["translation", "silence"],    ["translation", "cochlear"],
  ["caption",     "exhibition"], ["voice",       "silence"],
  ["voice",       "text"],       ["text",        "fiction"],
  ["fiction",     "imagination"],["death",       "online"],
  ["christianity","market"],     ["conversion",  "institution"],
  ["conversion",  "accessibility"],["body",      "cochlear"],
  ["memory",      "exhibition"], ["institution", "market"],
  ["poetics",     "fiction"],
];

const PAGE_LABELS = {
  "/exhibitions/": "Exhibitions",
  "/writings/":    "Writings",
  "/works/":       "Works",
  "/research/":    "Research",
  "/about/":       "About",
  "/diary/":       "Diary",
};

const TERM_PAGES = {
  curation:     ["/exhibitions/", "/research/", "/about/"],
  anthropology: ["/research/",    "/writings/"],
  care:         ["/exhibitions/", "/research/"],
  exhibition:   ["/exhibitions/", "/works/"],
  conversion:   ["/research/",    "/about/"],
  cochlear:     ["/about/",       "/research/"],
  voice:        ["/writings/",    "/research/"],
  silence:      ["/writings/",    "/exhibitions/"],
  translation:  ["/writings/",    "/research/"],
  caption:      ["/exhibitions/", "/works/"],
  text:         ["/writings/",    "/research/"],
  body:         ["/research/",    "/writings/"],
  eastasia:     ["/research/",    "/exhibitions/"],
  death:        ["/research/",    "/writings/"],
  online:       ["/research/",    "/works/"],
  christianity: ["/research/"],
  market:       ["/research/",    "/exhibitions/"],
  institution:  ["/research/",    "/exhibitions/"],
  memory:       ["/exhibitions/", "/writings/"],
  imagination:  ["/writings/",    "/research/"],
  fiction:      ["/writings/",    "/research/"],
  poetics:      ["/writings/",    "/research/"],
  accessibility:["/research/",    "/exhibitions/", "/works/"],
};

// ── DOM refs ─────────────────────────────────────────────
const svg      = document.getElementById("network-svg");
const container= document.getElementById("floating-network");
const popup    = document.getElementById("term-popup");
const popLabel = document.getElementById("term-popup-label");
const popLinks = document.getElementById("term-popup-links");
const popClose = document.getElementById("term-popup-close");

if (svg && container && popup) {
  const pos     = {};
  const cur     = {};
  const nodeEls = {};
  const lineEls = {};
  let rafId = 0, startTime = 0;
  let W = 0, H = 0;

  let draggingId      = null;
  let dragStartClient = null;
  let dragOffsetX     = 0;
  let dragOffsetY     = 0;
  const DRAG_PX = 5;

  let mouse = { x: null, y: null };

  function rnd(min, max) { return Math.random() * (max - min) + min; }

  // SVG element coordinates = client coordinates when container is fixed inset:0
  function svgCoords(clientX, clientY) {
    const rect = svg.getBoundingClientRect();
    return {
      x: (clientX - rect.left) * (W / (rect.width  || W)),
      y: (clientY - rect.top)  * (H / (rect.height || H)),
    };
  }

  // Convert SVG position back to client coordinates (for popup placement)
  function svgToClient(svgX, svgY) {
    const rect = svg.getBoundingClientRect();
    return {
      x: rect.left + svgX * (rect.width  / W),
      y: rect.top  + svgY * (rect.height / H),
    };
  }

  function mkEl(tag) {
    return document.createElementNS("http://www.w3.org/2000/svg", tag);
  }

  // ── Build ────────────────────────────────────────────────
  function build() {
    W = container.clientWidth  || window.innerWidth;
    H = container.clientHeight || window.innerHeight;

    svg.innerHTML = "";
    for (const k in nodeEls) delete nodeEls[k];
    for (const k in lineEls) delete lineEls[k];
    for (const k in pos)     delete pos[k];
    for (const k in cur)     delete cur[k];

    // Center nodes in the right portion of the viewport,
    // matching the old right:3vw / width:40vw / top:10vh / height:72vh layout.
    const cx   = W * 0.74;
    const cy   = H * 0.44;
    const vmin = Math.min(W, H);

    const rings = [
      { rx: vmin * 0.110, ry: vmin * 0.095 },
      { rx: vmin * 0.210, ry: vmin * 0.185 },
      { rx: vmin * 0.275, ry: vmin * 0.245 },
    ];

    const byLayer = [[], [], []];
    TERMS.forEach(t => byLayer[t.layer].push(t));

    byLayer.forEach((nodes, li) => {
      const { rx, ry } = rings[li];
      nodes.forEach((t, i) => {
        const angle = (Math.PI * 2 * i / nodes.length) + rnd(-0.28, 0.28);
        pos[t.id] = {
          bx:  cx + Math.cos(angle) * rx * rnd(0.82, 1.18),
          by:  cy + Math.sin(angle) * ry * rnd(0.82, 1.18),
          px:  rnd(0, Math.PI * 2), py:  rnd(0, Math.PI * 2),
          px2: rnd(0, Math.PI * 2), py2: rnd(0, Math.PI * 2),
          ax:  rnd(8, 18),           ay:  rnd(6, 14),
          ax2: rnd(2, 6),            ay2: rnd(2, 5),
          sx:  rnd(0.000025, 0.000055), sy:  rnd(0.000020, 0.000050),
          sx2: rnd(0.000010, 0.000026), sy2: rnd(0.000012, 0.000030),
        };
        cur[t.id] = { x: pos[t.id].bx, y: pos[t.id].by };
      });
    });

    // Lines
    LINKS.forEach(([src, tgt]) => {
      const ps = pos[src], pt = pos[tgt];
      if (!ps || !pt) return;
      const el = mkEl("line");
      el.setAttribute("x1", ps.bx); el.setAttribute("y1", ps.by);
      el.setAttribute("x2", pt.bx); el.setAttribute("y2", pt.by);
      el.setAttribute("stroke",       BLUE);
      el.setAttribute("fill",         "none");
      el.setAttribute("stroke-width", "0.7");
      el.setAttribute("opacity",      "0.18");
      el.style.pointerEvents = "none";
      svg.appendChild(el);
      lineEls[`${src}-${tgt}`] = el;
    });

    // Text nodes
    TERMS.forEach(t => {
      const p  = pos[t.id];
      const [en, ja] = t.label;
      const hasLink  = Boolean(TERM_PAGES[t.id]);

      const textEl = mkEl("text");
      textEl.setAttribute("x",             p.bx);
      textEl.setAttribute("y",             p.by);
      textEl.setAttribute("fill",          BLUE);
      textEl.setAttribute("opacity",       String(LAYER.opacity[t.layer]));
      textEl.setAttribute("font-size",     LAYER.fontSize[t.layer]);
      textEl.setAttribute("font-family",   "inherit");
      textEl.setAttribute("letter-spacing","0.04em");
      textEl.setAttribute("text-anchor",   "middle");
      textEl.style.pointerEvents = "auto";
      textEl.style.cursor        = hasLink ? "pointer" : "grab";
      textEl.dataset.termId      = t.id;

      const sp1 = mkEl("tspan");
      sp1.setAttribute("x", p.bx); sp1.setAttribute("dy", "-0.65em");
      sp1.textContent = en;

      const sp2 = mkEl("tspan");
      sp2.setAttribute("x", p.bx); sp2.setAttribute("dy", "1.35em");
      sp2.setAttribute("font-size", "0.93em");
      sp2.textContent = ja;

      textEl.appendChild(sp1);
      textEl.appendChild(sp2);
      svg.appendChild(textEl);
      nodeEls[t.id] = textEl;

      // Hover: highlight node and its connected lines
      textEl.addEventListener("mouseenter", () => {
        textEl.setAttribute("opacity", "1");
        textEl.setAttribute("font-weight", "500");
        LINKS.forEach(([src, tgt]) => {
          if (src === t.id || tgt === t.id) {
            const line = lineEls[`${src}-${tgt}`];
            if (line) {
              line.setAttribute("opacity", "0.42");
              line.setAttribute("stroke-width", "0.9");
            }
          }
        });
      });
      textEl.addEventListener("mouseleave", () => {
        textEl.setAttribute("opacity", String(LAYER.opacity[t.layer]));
        textEl.setAttribute("font-weight", "400");
        LINKS.forEach(([src, tgt]) => {
          if (src === t.id || tgt === t.id) {
            const line = lineEls[`${src}-${tgt}`];
            if (line) {
              line.setAttribute("opacity", "0.18");
              line.setAttribute("stroke-width", "0.7");
            }
          }
        });
      });
    });

    cancelAnimationFrame(rafId);
    startTime = 0;
    rafId = requestAnimationFrame(animate);
  }

  // ── Animate ──────────────────────────────────────────────
  function animate(timestamp) {
    if (!startTime) startTime = timestamp;
    const elapsed = timestamp - startTime;

    TERMS.forEach(t => {
      const p = pos[t.id], el = nodeEls[t.id];
      if (!p || !el) return;

      let x, y;
      if (t.id === draggingId) {
        x = p.bx; y = p.by;
      } else {
        x = p.bx
          + Math.sin(elapsed * p.sx  + p.px)  * p.ax
          + Math.sin(elapsed * p.sx2 + p.px2) * p.ax2;
        y = p.by
          + Math.cos(elapsed * p.sy  + p.py)  * p.ay
          + Math.sin(elapsed * p.sy2 + p.py2) * p.ay2;

        // Gently attract nodes toward cursor when nearby
        if (mouse.x !== null) {
          const dx   = mouse.x - x;
          const dy   = mouse.y - y;
          const dist = Math.sqrt(dx * dx + dy * dy) || 1;
          const radius = 120;
          if (dist < radius) {
            const force = (1 - dist / radius) * 8;
            x += (dx / dist) * force;
            y += (dy / dist) * force;
          }
        }
      }

      cur[t.id] = { x, y };
      el.setAttribute("x", x);
      el.setAttribute("y", y);
      el.querySelectorAll("tspan").forEach(sp => sp.setAttribute("x", x));
    });

    LINKS.forEach(([src, tgt]) => {
      const ps = cur[src], pt = cur[tgt], el = lineEls[`${src}-${tgt}`];
      if (ps && pt && el) {
        el.setAttribute("x1", ps.x); el.setAttribute("y1", ps.y);
        el.setAttribute("x2", pt.x); el.setAttribute("y2", pt.y);
      }
    });

    rafId = requestAnimationFrame(animate);
  }

  // ── Popup ────────────────────────────────────────────────
  function showPopup(termId, clientX, clientY) {
    const term  = TERMS.find(t => t.id === termId);
    const pages = TERM_PAGES[termId];
    if (!term || !pages?.length) return;

    popLabel.textContent = `${term.label[0]}  /  ${term.label[1]}`;
    popLinks.innerHTML   = "";
    pages.forEach(href => {
      const li = document.createElement("li");
      const a  = document.createElement("a");
      a.href        = href;
      a.textContent = PAGE_LABELS[href] || href;
      li.appendChild(a);
      popLinks.appendChild(li);
    });

    popup.style.visibility = "hidden";
    popup.style.display    = "block";

    requestAnimationFrame(() => {
      const r    = popup.getBoundingClientRect();
      let left   = clientX + 16;
      let top    = clientY - r.height / 2;
      if (left + r.width  > window.innerWidth  - 12) left = clientX - r.width - 16;
      if (left < 12)                                  left = 12;
      if (top  < 12)                                  top  = 12;
      if (top  + r.height > window.innerHeight - 12)  top  = window.innerHeight - r.height - 12;
      popup.style.left       = left + "px";
      popup.style.top        = top  + "px";
      popup.style.visibility = "visible";
    });
  }

  function hidePopup() {
    popup.style.display = "none";
  }

  popClose.addEventListener("click", hidePopup);

  // Show a random term popup on page load
  function showRandomPopup() {
    if (window.innerWidth <= 900) return;
    const linkable = TERMS.filter(t => TERM_PAGES[t.id]?.length > 0);
    if (!linkable.length) return;
    const term = linkable[Math.floor(Math.random() * linkable.length)];
    const node = cur[term.id];
    if (!node) return;
    const { x, y } = svgToClient(node.x, node.y);
    showPopup(term.id, x, y);
  }

  // ── Pointer events ───────────────────────────────────────
  document.addEventListener("pointerdown", e => {
    if (popup.style.display === "block" && !popup.contains(e.target)) {
      hidePopup();
    }

    const textEl = e.target.closest ? e.target.closest("[data-term-id]") : null;
    const id     = textEl?.dataset?.termId;
    if (!id || !cur[id]) return;

    draggingId      = id;
    dragStartClient = { x: e.clientX, y: e.clientY };
    textEl.style.cursor = "grabbing";

    const svgP  = svgCoords(e.clientX, e.clientY);
    dragOffsetX = svgP.x - cur[id].x;
    dragOffsetY = svgP.y - cur[id].y;
    e.preventDefault();
  });

  document.addEventListener("pointermove", e => {
    mouse = svgCoords(e.clientX, e.clientY);
    if (!draggingId || !dragStartClient) return;
    const dx = e.clientX - dragStartClient.x;
    const dy = e.clientY - dragStartClient.y;
    if (Math.sqrt(dx * dx + dy * dy) < DRAG_PX) return;
    const { x, y } = svgCoords(e.clientX, e.clientY);
    pos[draggingId].bx = x - dragOffsetX;
    pos[draggingId].by = y - dragOffsetY;
  });

  document.addEventListener("pointerup", e => {
    if (!draggingId) return;
    const id = draggingId;
    const dx = e.clientX - (dragStartClient?.x ?? e.clientX);
    const dy = e.clientY - (dragStartClient?.y ?? e.clientY);
    const wasDrag = Math.sqrt(dx * dx + dy * dy) >= DRAG_PX;

    if (nodeEls[id]) nodeEls[id].style.cursor = TERM_PAGES[id] ? "pointer" : "grab";
    pos[id].bx      = cur[id].x;
    pos[id].by      = cur[id].y;
    draggingId      = null;
    dragStartClient = null;

    if (!wasDrag && TERM_PAGES[id]) {
      showPopup(id, e.clientX, e.clientY);
    }
  });

  // ── Init ─────────────────────────────────────────────────
  function waitAndBuild() {
    if (container.clientWidth === 0) { requestAnimationFrame(waitAndBuild); return; }
    build();
    setTimeout(showRandomPopup, 800);
  }
  requestAnimationFrame(waitAndBuild);

  let resizeTimer = 0;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => { draggingId = null; hidePopup(); build(); }, 200);
  });
}
</script>
