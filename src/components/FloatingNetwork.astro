---
---
<div id="floating-network" aria-hidden="true">
  <svg id="network-svg" aria-hidden="true"></svg>
</div>

<style>
  #floating-network {
    position: fixed;
    top: 10vh;
    right: 3vw;
    width: min(40vw, 580px);
    height: 72vh;
    z-index: 10;
    opacity: 0.85;
    mix-blend-mode: multiply;
    pointer-events: none;
    user-select: none;
    will-change: transform;
  }

  #network-svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  @media (prefers-color-scheme: dark) {
    #floating-network {
      mix-blend-mode: screen;
      opacity: 0.52;
    }
  }

  @media (max-width: 900px) {
    #floating-network {
      position: static;
      width: 100%;
      height: 220px;
      opacity: 0.65;
      margin-bottom: 2.5rem;
      mix-blend-mode: normal;
    }
  }
</style>

<script>
// All SVG element styles are set directly in JS to bypass Astro's scoped CSS.

const BLUE = "#0000ff";

const LAYER = {
  fontSize:  ["13px",   "10.5px", "8.5px"],
  opacity:   [0.90,     0.68,     0.46],
};

const TERMS = [
  { id: "curation",     label: ["curation",          "キュレーション"],     layer: 0 },
  { id: "anthropology", label: ["anthropology",       "人類学"],            layer: 0 },
  { id: "care",         label: ["care",               "ケア"],               layer: 0 },
  { id: "exhibition",   label: ["exhibition space",   "展示空間"],           layer: 0 },
  { id: "conversion",   label: ["conditions of conv.","変換条件"],           layer: 0 },
  { id: "cochlear",     label: ["cochlear implant",   "人工内耳"],           layer: 1 },
  { id: "voice",        label: ["voice",              "声"],                 layer: 1 },
  { id: "silence",      label: ["silence",            "沈黙"],               layer: 1 },
  { id: "translation",  label: ["translation",        "翻訳"],               layer: 1 },
  { id: "caption",      label: ["caption",            "キャプション"],       layer: 1 },
  { id: "text",         label: ["text",               "テクスト"],           layer: 1 },
  { id: "body",         label: ["body",               "身体"],               layer: 1 },
  { id: "eastasia",     label: ["East Asia",          "東アジア"],           layer: 2 },
  { id: "death",        label: ["death",              "死"],                 layer: 2 },
  { id: "online",       label: ["online space",       "オンライン空間"],     layer: 2 },
  { id: "christianity", label: ["Christian paradigm", "キリスト教的範例性"], layer: 2 },
  { id: "market",       label: ["market economy",     "市場経済"],           layer: 2 },
  { id: "institution",  label: ["institution",        "制度"],               layer: 2 },
  { id: "memory",       label: ["memory",             "記憶"],               layer: 2 },
  { id: "imagination",  label: ["imagination",        "想像力"],             layer: 2 },
  { id: "fiction",      label: ["make-believe",       "フィクション"],       layer: 2 },
  { id: "poetics",      label: ["poetics",            "詩学"],               layer: 2 },
  { id: "accessibility",label: ["accessibility",      "アクセシビリティ"],   layer: 2 },
];

const LINKS = [
  ["curation",    "exhibition"],
  ["curation",    "conversion"],
  ["curation",    "institution"],
  ["curation",    "memory"],
  ["curation",    "imagination"],
  ["anthropology","translation"],
  ["anthropology","eastasia"],
  ["anthropology","poetics"],
  ["care",        "body"],
  ["care",        "accessibility"],
  ["care",        "cochlear"],
  ["translation", "caption"],
  ["translation", "silence"],
  ["translation", "cochlear"],
  ["caption",     "exhibition"],
  ["voice",       "silence"],
  ["voice",       "text"],
  ["text",        "fiction"],
  ["fiction",     "imagination"],
  ["death",       "online"],
  ["christianity","market"],
  ["conversion",  "institution"],
  ["conversion",  "accessibility"],
  ["body",        "cochlear"],
  ["memory",      "exhibition"],
  ["institution", "market"],
  ["poetics",     "fiction"],
];

const svg = document.getElementById("network-svg");
const container = document.getElementById("floating-network");

if (svg && container) {
  const pos = {};
  const cur = {};
  const nodeEls = {};
  const lineEls = {};
  let rafId = 0;
  let startTime = 0;
  let W = 0, H = 0;

  let draggingId = null;
  let dragOffsetX = 0, dragOffsetY = 0;

  function rnd(min, max) { return Math.random() * (max - min) + min; }

  function svgCoords(clientX, clientY) {
    const rect = svg.getBoundingClientRect();
    return {
      x: (clientX - rect.left) * (W / (rect.width  || W)),
      y: (clientY - rect.top)  * (H / (rect.height || H)),
    };
  }

  function mkEl(tag) {
    return document.createElementNS("http://www.w3.org/2000/svg", tag);
  }

  function build() {
    W = container.clientWidth  || 400;
    H = container.clientHeight || 500;

    svg.innerHTML = "";
    for (const k in nodeEls) delete nodeEls[k];
    for (const k in lineEls) delete lineEls[k];
    for (const k in pos)     delete pos[k];
    for (const k in cur)     delete cur[k];

    const cx = W / 2, cy = H / 2;
    const byLayer = [[], [], []];
    TERMS.forEach(t => byLayer[t.layer].push(t));

    const rings = [
      { rx: W * 0.20, ry: H * 0.17 },
      { rx: W * 0.37, ry: H * 0.33 },
      { rx: W * 0.48, ry: H * 0.46 },
    ];

    byLayer.forEach((nodes, li) => {
      const { rx, ry } = rings[li];
      nodes.forEach((t, i) => {
        const angle = (Math.PI * 2 * i / nodes.length) + rnd(-0.28, 0.28);
        pos[t.id] = {
          bx: cx + Math.cos(angle) * rx * rnd(0.82, 1.18),
          by: cy + Math.sin(angle) * ry * rnd(0.82, 1.18),
          px: rnd(0, Math.PI * 2),
          py: rnd(0, Math.PI * 2),
          ax: rnd(1.5, 3.5),
          ay: rnd(1.5, 3.5),
          sx: rnd(0.00010, 0.00025),
          sy: rnd(0.00010, 0.00025),
        };
        cur[t.id] = { x: pos[t.id].bx, y: pos[t.id].by };
      });
    });

    // Lines — all styles set directly (Astro scoped CSS doesn't reach dynamic elements)
    LINKS.forEach(([src, tgt]) => {
      const ps = pos[src], pt = pos[tgt];
      if (!ps || !pt) return;
      const el = mkEl("line");
      el.setAttribute("x1", ps.bx);
      el.setAttribute("y1", ps.by);
      el.setAttribute("x2", pt.bx);
      el.setAttribute("y2", pt.by);
      el.setAttribute("stroke", BLUE);
      el.setAttribute("fill", "none");
      el.setAttribute("stroke-width", "0.7");
      el.setAttribute("opacity", "0.28");
      el.style.pointerEvents = "none";
      svg.appendChild(el);
      lineEls[`${src}-${tgt}`] = el;
    });

    // Text nodes — all styles set directly
    TERMS.forEach(t => {
      const p = pos[t.id];
      const [en, ja] = t.label;

      const textEl = mkEl("text");
      textEl.setAttribute("x", p.bx);
      textEl.setAttribute("y", p.by);
      textEl.setAttribute("fill", BLUE);
      textEl.setAttribute("opacity", String(LAYER.opacity[t.layer]));
      textEl.setAttribute("font-size", LAYER.fontSize[t.layer]);
      textEl.setAttribute("font-family", "inherit");
      textEl.setAttribute("letter-spacing", "0.04em");
      textEl.setAttribute("text-anchor", "middle");
      textEl.style.pointerEvents = "auto";
      textEl.style.cursor = "grab";
      textEl.dataset.termId = t.id;

      const sp1 = mkEl("tspan");
      sp1.setAttribute("x", p.bx);
      sp1.setAttribute("dy", "-0.65em");
      sp1.textContent = en;

      const sp2 = mkEl("tspan");
      sp2.setAttribute("x", p.bx);
      sp2.setAttribute("dy", "1.35em");
      sp2.setAttribute("font-size", "0.93em");
      sp2.textContent = ja;

      textEl.appendChild(sp1);
      textEl.appendChild(sp2);
      svg.appendChild(textEl);
      nodeEls[t.id] = textEl;
    });

    cancelAnimationFrame(rafId);
    startTime = 0;
    rafId = requestAnimationFrame(animate);
  }

  function animate(timestamp) {
    if (!startTime) startTime = timestamp;
    const elapsed = timestamp - startTime;

    TERMS.forEach(t => {
      const p = pos[t.id];
      const el = nodeEls[t.id];
      if (!p || !el) return;

      let x, y;
      if (t.id === draggingId) {
        x = p.bx;
        y = p.by;
      } else {
        x = p.bx + Math.sin(elapsed * p.sx + p.px) * p.ax;
        y = p.by + Math.cos(elapsed * p.sy + p.py) * p.ay;
      }
      cur[t.id] = { x, y };

      el.setAttribute("x", x);
      el.setAttribute("y", y);
      el.querySelectorAll("tspan").forEach(sp => sp.setAttribute("x", x));
    });

    LINKS.forEach(([src, tgt]) => {
      const ps = cur[src], pt = cur[tgt];
      const el = lineEls[`${src}-${tgt}`];
      if (ps && pt && el) {
        el.setAttribute("x1", ps.x);
        el.setAttribute("y1", ps.y);
        el.setAttribute("x2", pt.x);
        el.setAttribute("y2", pt.y);
      }
    });

    rafId = requestAnimationFrame(animate);
  }

  // Per-node drag
  document.addEventListener("pointerdown", e => {
    const textEl = e.target.closest
      ? e.target.closest("[data-term-id]")
      : null;
    const id = textEl && textEl.dataset && textEl.dataset.termId;
    if (!id || !cur[id]) return;

    draggingId = id;
    textEl.style.cursor = "grabbing";
    const { x, y } = svgCoords(e.clientX, e.clientY);
    dragOffsetX = x - cur[id].x;
    dragOffsetY = y - cur[id].y;
    e.preventDefault();
  });

  document.addEventListener("pointermove", e => {
    if (!draggingId) return;
    const { x, y } = svgCoords(e.clientX, e.clientY);
    pos[draggingId].bx = x - dragOffsetX;
    pos[draggingId].by = y - dragOffsetY;
  });

  document.addEventListener("pointerup", () => {
    if (draggingId) {
      if (nodeEls[draggingId]) nodeEls[draggingId].style.cursor = "grab";
      pos[draggingId].bx = cur[draggingId].x;
      pos[draggingId].by = cur[draggingId].y;
      draggingId = null;
    }
  });

  function waitAndBuild() {
    if (container.clientWidth === 0) {
      requestAnimationFrame(waitAndBuild);
      return;
    }
    build();
  }
  requestAnimationFrame(waitAndBuild);

  let resizeTimer = 0;
  window.addEventListener("resize", () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      draggingId = null;
      build();
    }, 200);
  });
}
</script>
