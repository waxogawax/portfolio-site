---
// Turing reaction-diffusion field — decorative background.
// Canvas is position:fixed, pointer-events:none, z-index:0.
// Content sits at z-index ≥ 1.
---

<canvas class="turing-field" aria-hidden="true"></canvas>

<style>
  .turing-field {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }
</style>

<script>
  function initTuringField() {
    const canvas = document.querySelector('.turing-field');
    if (!(canvas instanceof HTMLCanvasElement)) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isMobile  = window.innerWidth < 768;
    const SCALE     = isMobile ? 0.25 : 0.40;
    const N         = isMobile ? 5    : 9;
    const FRAME_MS  = 1000 / 20;

    function resize() {
      canvas.width  = Math.floor(window.innerWidth  * SCALE);
      canvas.height = Math.floor(window.innerHeight * SCALE);
    }
    resize();
    window.addEventListener('resize', () => {
      resize();
      if (prefersReduced || isMobile) draw(performance.now());
    }, { passive: true });

    const pts = Array.from({ length: N }, () => ({
      x:     0.05 + Math.random() * 0.90,
      y:     0.10 + Math.random() * 0.78,
      vx:    (Math.random() - 0.5) * 0.00006,
      vy:    (Math.random() - 0.5) * 0.00006,
      r:     0.26 + Math.random() * 0.20,
      phase: Math.random() * Math.PI * 2,
      conc:  Math.random(),
    }));

    // ── Cursor field state ────────────────────────────────────────────────────
    const cursor     = { x: null, y: null, speed: 0 };
    const cursorTrail = [];
    const TRAIL_LIFE  = 1400; // ms

    function update(dt) {
      const W = canvas.width, H = canvas.height;
      for (let i = 0; i < N; i++) {
        const p = pts[i];
        p.x += p.vx * dt;
        p.y += p.vy * dt;

        if (p.x < 0.05) p.vx += 0.000003 * dt;
        if (p.x > 0.95) p.vx -= 0.000003 * dt;
        if (p.y < 0.08) p.vy += 0.000003 * dt;
        if (p.y > 0.92) p.vy -= 0.000003 * dt;

        p.vy += 0.0000008 * dt * (0.50 - p.y);
        p.phase += 0.0004 * dt;

        let inhibition = 0;
        for (let j = 0; j < N; j++) {
          if (j === i) continue;
          const dx   = (pts[j].x - p.x) * W;
          const dy   = (pts[j].y - p.y) * H;
          const dist = Math.sqrt(dx * dx + dy * dy);
          const iR   = W * 0.42;
          if (dist < iR) inhibition += pts[j].conc * (1 - dist / iR);
        }

        const rate = 0.00015 * dt;
        p.conc += rate * (1 - p.conc)
                - rate * 2.0 * inhibition
                + (Math.random() - 0.5) * 0.0002 * dt;
        p.conc = Math.max(0.04, Math.min(1, p.conc));
      }

      // Cursor field perturbation — nudge concentration and drift when cursor is near.
      // Skipped when cursor.x is null (mobile / reduced-motion: never set).
      if (cursor.x !== null) {
        for (let i = 0; i < N; i++) {
          const p  = pts[i];
          const dx = cursor.x - p.x;
          const dy = cursor.y - p.y;
          const dist   = Math.sqrt(dx * dx + dy * dy);
          const radius = 0.22;
          if (dist < radius) {
            const influence = 1 - dist / radius;
            p.conc += influence * cursor.speed * 0.0028 * dt;
            p.conc  = Math.max(0.04, Math.min(1, p.conc));
            p.vx   += dx * influence * 0.00000025 * dt;
            p.vy   += dy * influence * 0.00000025 * dt;
          }
        }
      }
    }

    // ── Dual-pulse activations ────────────────────────────────────────────────
    const INNER_LIFE  = 950;
    const OUTER_LIFE  = 3800;
    const OUTER_GROW  = 0.105;
    const OUTER_MAX   = 0.46;
    const OUTER_START = 0.06;

    let activations = [];
    const hoverMap  = new Map();

    function outerRAt(hoverMs) {
      const W = canvas.width;
      return Math.min(W * OUTER_MAX, W * OUTER_START + W * OUTER_GROW * (hoverMs / 1000));
    }

    function addActivation(el, nx, ny) {
      const prev = hoverMap.get(el);
      if (prev && prev.hoverEnded === null) {
        prev.hoverEnded = performance.now();
        prev.outerFadeR = outerRAt(prev.hoverEnded - prev.hoverStart);
      }
      const a = {
        x:          nx,
        y:          ny,
        born:       performance.now(),
        hoverStart: performance.now(),
        hoverEnded: null,
        outerFadeR: 0,
      };
      activations.push(a);
      hoverMap.set(el, a);
      if (activations.length > 10) activations.shift();
    }

    function endActivation(el) {
      const a = hoverMap.get(el);
      if (a && a.hoverEnded === null) {
        a.hoverEnded = performance.now();
        a.outerFadeR = outerRAt(a.hoverEnded - a.hoverStart);
        hoverMap.delete(el);
      }
    }

    // ── Scan wave constants ───────────────────────────────────────────────────
    const SCAN_WIDTH      = 0.18;
    const SCAN_ALPHA_PEAK = 0.020;
    const SCAN_PART_BASE  = 0.055;
    const SCAN_PART_BOOST = 0.032;
    const SCAN_OUT_BOOST  = 0.018;

    // ── Draw ─────────────────────────────────────────────────────────────────
    function draw(now) {
      const W = canvas.width, H = canvas.height;
      ctx.clearRect(0, 0, W, H);

      const scanY = (prefersReduced || isMobile)
        ? -2
        : 0.08 + ((now * 0.000035) % 0.84);

      function boost(ny) {
        return Math.max(0, 1 - Math.abs(ny - scanY) / SCAN_WIDTH);
      }

      // Background field wash
      const fieldGrd = ctx.createLinearGradient(0, H * 0.05, 0, H * 0.95);
      fieldGrd.addColorStop(0,    'rgba(255,255,0,0)');
      fieldGrd.addColorStop(0.10, 'rgba(255,255,0,0.014)');
      fieldGrd.addColorStop(0.45, 'rgba(255,255,0,0.026)');
      fieldGrd.addColorStop(0.80, 'rgba(255,255,0,0.018)');
      fieldGrd.addColorStop(1,    'rgba(255,255,0,0)');
      ctx.fillStyle = fieldGrd;
      ctx.fillRect(0, 0, W, H);

      // Scan wave band
      if (!prefersReduced && !isMobile) {
        const bandH   = SCAN_WIDTH * H;
        const scanYpx = scanY * H;
        const sg = ctx.createLinearGradient(0, scanYpx - bandH, 0, scanYpx + bandH);
        sg.addColorStop(0,   'rgba(255,255,0,0)');
        sg.addColorStop(0.5, `rgba(255,255,0,${SCAN_ALPHA_PEAK})`);
        sg.addColorStop(1,   'rgba(255,255,0,0)');
        ctx.fillStyle = sg;
        ctx.fillRect(0, Math.max(0, scanYpx - bandH), W, Math.min(H, bandH * 2));
      }

      // Cursor trail — faint viscous residue of cursor path through the field.
      // Drawn after scan wave, before particle halos, so it reads as field disturbance.
      if (!prefersReduced && !isMobile && cursorTrail.length > 0) {
        const alive = [];
        for (const pt of cursorTrail) {
          const age = now - pt.born;
          if (age >= TRAIL_LIFE) continue;
          alive.push(pt);
          const fade  = 1 - age / TRAIL_LIFE;
          const alpha = fade * 0.028;
          const px    = pt.x * W;
          const py    = pt.y * H;
          const r     = W * 0.016;
          const tg    = ctx.createRadialGradient(px, py, 0, px, py, r);
          tg.addColorStop(0, `rgba(255,255,0,${alpha.toFixed(4)})`);
          tg.addColorStop(1, 'rgba(255,255,0,0)');
          ctx.fillStyle = tg;
          ctx.beginPath();
          ctx.arc(px, py, r, 0, Math.PI * 2);
          ctx.fill();
        }
        cursorTrail.length = 0;
        cursorTrail.push(...alive);
      }

      // Particle halos
      for (const p of pts) {
        const px    = p.x * W, py = p.y * H;
        const pulse = 0.88 + 0.12 * Math.sin(p.phase);
        const oR    = p.r * W * pulse;
        const b     = boost(p.y);
        const alpha = p.conc * (SCAN_PART_BASE + b * SCAN_PART_BOOST);

        const og = ctx.createRadialGradient(px, py, 0, px, py, oR);
        og.addColorStop(0,    `rgba(255,255,0,${alpha.toFixed(4)})`);
        og.addColorStop(0.40, `rgba(255,255,0,${(alpha * 0.30).toFixed(4)})`);
        og.addColorStop(1,    'rgba(255,255,0,0)');
        ctx.fillStyle = og;
        ctx.beginPath();
        ctx.arc(px, py, oR, 0, Math.PI * 2);
        ctx.fill();

        if (p.conc > 0.28) {
          const iR = p.r * W * 0.28 * pulse;
          const ia = (p.conc - 0.28) * 0.09;
          const ig = ctx.createRadialGradient(px, py, 0, px, py, iR);
          ig.addColorStop(0, `rgba(255,255,0,${ia.toFixed(4)})`);
          ig.addColorStop(1, 'rgba(255,255,0,0)');
          ctx.fillStyle = ig;
          ctx.beginPath();
          ctx.arc(px, py, iR, 0, Math.PI * 2);
          ctx.fill();
        }
      }

      // Dual-pulse activations
      const nextActs = [];
      for (const a of activations) {
        const px  = a.x * W, py = a.y * H;
        const b   = boost(a.y);
        let innerAlive = false;
        let outerAlive = false;

        const innerT = (now - a.born) / INNER_LIFE;
        if (innerT < 1.0) {
          innerAlive  = true;
          const fade  = 0.5 * (1 + Math.cos(Math.PI * innerT));
          const iR    = W * (0.040 + innerT * 0.052);
          const alpha = fade * 0.40;

          const ig = ctx.createRadialGradient(px, py, 0, px, py, iR);
          ig.addColorStop(0,    `rgba(255,255,0,${alpha.toFixed(4)})`);
          ig.addColorStop(0.45, `rgba(255,255,0,${(alpha * 0.42).toFixed(4)})`);
          ig.addColorStop(1,    'rgba(255,255,0,0)');
          ctx.fillStyle = ig;
          ctx.beginPath();
          ctx.arc(px, py, iR, 0, Math.PI * 2);
          ctx.fill();
        }

        if (a.hoverEnded === null) {
          outerAlive  = true;
          const oR    = outerRAt(now - a.hoverStart);
          const alpha = 0.078 + b * SCAN_OUT_BOOST;

          const og = ctx.createRadialGradient(px, py, 0, px, py, oR);
          og.addColorStop(0,    `rgba(255,255,0,${alpha.toFixed(4)})`);
          og.addColorStop(0.28, `rgba(255,255,0,${(alpha * 0.58).toFixed(4)})`);
          og.addColorStop(0.65, `rgba(255,255,0,${(alpha * 0.20).toFixed(4)})`);
          og.addColorStop(1,    'rgba(255,255,0,0)');
          ctx.fillStyle = og;
          ctx.beginPath();
          ctx.arc(px, py, oR, 0, Math.PI * 2);
          ctx.fill();
        } else {
          const outerT = (now - a.hoverEnded) / OUTER_LIFE;
          if (outerT < 1.0) {
            outerAlive  = true;
            const fade  = 0.5 * (1 + Math.cos(Math.PI * outerT));
            const oR    = a.outerFadeR * (1 + outerT * 0.14);
            const alpha = fade * (0.068 + b * SCAN_OUT_BOOST * 0.6);

            const og = ctx.createRadialGradient(px, py, 0, px, py, oR);
            og.addColorStop(0,    `rgba(255,255,0,${alpha.toFixed(4)})`);
            og.addColorStop(0.28, `rgba(255,255,0,${(alpha * 0.58).toFixed(4)})`);
            og.addColorStop(0.65, `rgba(255,255,0,${(alpha * 0.20).toFixed(4)})`);
            og.addColorStop(1,    'rgba(255,255,0,0)');
            ctx.fillStyle = og;
            ctx.beginPath();
            ctx.arc(px, py, oR, 0, Math.PI * 2);
            ctx.fill();
          }
        }

        if (innerAlive || outerAlive || a.hoverEnded === null) {
          nextActs.push(a);
        }
      }
      activations = nextActs;
    }

    // Pre-warm
    for (let i = 0; i < 500; i++) update(16);

    if (prefersReduced || isMobile) {
      draw(performance.now());
      return;
    }

    // ── Hover activations on interactive elements ─────────────────────────────
    const reactive = [
      ...document.querySelectorAll('.index-item'),
      ...document.querySelectorAll('.home-intro h1, .home-intro p'),
    ];
    reactive.forEach(el => {
      el.addEventListener('mouseenter', () => {
        const rect = el.getBoundingClientRect();
        addActivation(
          el,
          (rect.left + rect.width  * 0.5) / window.innerWidth,
          (rect.top  + rect.height * 0.5) / window.innerHeight,
        );
      });
      el.addEventListener('mouseleave', () => endActivation(el));
    });

    // ── Cursor field interaction ──────────────────────────────────────────────
    // pointermove updates normalized cursor position and appends to trail.
    // Only registered on desktop/non-reduced paths — cursor.x stays null otherwise,
    // which silently disables the update() perturbation and draw() trail.
    window.addEventListener('pointermove', e => {
      const nx = e.clientX / window.innerWidth;
      const ny = e.clientY / window.innerHeight;
      if (cursor.x !== null) {
        const dx = nx - cursor.x;
        const dy = ny - cursor.y;
        cursor.speed = Math.sqrt(dx * dx + dy * dy);
      }
      cursor.x = nx;
      cursor.y = ny;
      cursorTrail.push({ x: nx, y: ny, born: performance.now() });
    }, { passive: true });

    // ── Render loop ───────────────────────────────────────────────────────────
    let lastTime = null;
    const tick = (now) => {
      if (lastTime !== null && now - lastTime < FRAME_MS) {
        requestAnimationFrame(tick);
        return;
      }
      const dt = lastTime === null ? 16 : Math.min(now - lastTime, 60);
      lastTime = now;
      update(dt);
      draw(now);
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  initTuringField();
</script>
